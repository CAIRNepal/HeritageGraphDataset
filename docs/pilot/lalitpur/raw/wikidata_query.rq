# Wikidata: temples, stupas, monuments and heritage sites with coordinates in or around Lalitpur District (Q1108338).
# Items are selected by coordinates in the district's bounding box (85.21..85.43 E, 27.41..27.70 N, slightly widened);
# the district polygon is applied afterwards (tools/pilot/match.py). P131 is returned for information.
# Kept if an item is a temple Q44539, stupa Q180987, monument Q4989906 or heritage site Q358 (with subclasses via P279*),
# or has any heritage designation (P1435).
SELECT ?item ?itemLabel ?label_ne ?coord
       (GROUP_CONCAT(DISTINCT ?clsLabel; separator="; ") AS ?classes)
       (SAMPLE(?p131) AS ?p131) (SAMPLE(?image) AS ?image) (GROUP_CONCAT(DISTINCT ?heritageLabel; separator="; ") AS ?heritage)
       (SAMPLE(?inception) AS ?inception) (SAMPLE(?commons) AS ?commons)
       (SAMPLE(?osmNode) AS ?osmNode) (SAMPLE(?osmWay) AS ?osmWay) (SAMPLE(?osmRel) AS ?osmRel) (SAMPLE(?sitelinks) AS ?sitelinks)
WHERE {
  SERVICE wikibase:box {
    ?item wdt:P625 ?coord .
    bd:serviceParam wikibase:cornerSouthWest "Point(85.21 27.41)"^^geo:wktLiteral .
    bd:serviceParam wikibase:cornerNorthEast "Point(85.43 27.70)"^^geo:wktLiteral .
  }
  FILTER (EXISTS { ?item wdt:P31/wdt:P279* ?cls . VALUES ?cls { wd:Q44539 wd:Q180987 wd:Q4989906 wd:Q358 } }
          || EXISTS { ?item wdt:P1435 ?anyDesignation })
  ?item wdt:P31 ?c31 . ?c31 rdfs:label ?clsLabel FILTER(LANG(?clsLabel) = "en")
  OPTIONAL { ?item rdfs:label ?itemLabel FILTER(LANG(?itemLabel) = "en") }
  OPTIONAL { ?item rdfs:label ?label_ne FILTER(LANG(?label_ne) = "ne") }
  OPTIONAL { ?item wdt:P131 ?p131 }
  OPTIONAL { ?item wdt:P18 ?image }
  OPTIONAL { ?item wdt:P1435 ?h . ?h rdfs:label ?heritageLabel FILTER(LANG(?heritageLabel) = "en") }
  OPTIONAL { ?item wdt:P571 ?inception }
  OPTIONAL { ?item wdt:P373 ?commons }
  OPTIONAL { ?item wdt:P11693 ?osmNode }
  OPTIONAL { ?item wdt:P10689 ?osmWay }
  OPTIONAL { ?item wdt:P402 ?osmRel }
  OPTIONAL { ?item wikibase:sitelinks ?sitelinks }
}
GROUP BY ?item ?itemLabel ?label_ne ?coord
