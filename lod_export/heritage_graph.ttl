<https://data.cairnepal.org/heritage/resource/event/3527c75f-8262-4a09-802b-b3188ee27d40_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Offering of a bell"@en ;
    dcterms:description "Dharma Siṃha and Premanārāyaṇa Siṃha presented Rāma with a bell fifteen years before the Temple was built. This implies that a Rāma shrine existed before the Siṃha brothers built the current Temple for the deity."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/3527c75f-8262-4a09-802b-b3188ee27d40> ;
