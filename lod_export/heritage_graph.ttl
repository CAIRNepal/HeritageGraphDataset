<https://data.cairnepal.org/heritage/resource/event/d86c93ef-871c-4c0f-b33f-b44361137d5b_6> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Reconstruction of the temple"@en ;
    dcterms:description "As the temple was damaged by the 2015 CE (VS 2072) earthquake, it was reconstructed by the Department of Archaeology at a total cost of 6.3 million rupees. However, at the time of completion, the installation of metal roofing sheets (pātā) remained unfinished.विसं २०७२ को भूकम्पले मन्दिरमा क्षति पुगेकोले पुरातत्त्व विभागबाट मन्दिरको पुनर्निर्माण गरिएको थियो । उक्त कार्यमा ६३ लाख खर्च भएको थियो । उक्त पुनर्निर्माण सम्पन्न गर्दा छानामा पाता राख्ने काम भने बाँकी नै थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d86c93ef-871c-4c0f-b33f-b44361137d5b> ;
    rdfs:comment "As the temple was damaged by the 2015 CE (VS 2072) earthquake, it was reconstructed by the Department of Archaeology at a total cost of 6.3 million rupees. However, at the time of completion, the installation of metal roofing sheets (pātā) remained unfinished.विसं २०७२ को भूकम्पले मन्दिरमा क्षति पुगेकोले पुरातत्त्व विभागबाट मन्दिरको पुनर्निर्माण गरिएको थियो । उक्त कार्यमा ६३ लाख खर्च भएको थियो । उक्त पुनर्निर्माण सम्पन्न गर्दा छानामा पाता राख्ने काम भने बाँकी नै थियो ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
