        hg:HistoricalEvent ;
    rdfs:label "Donation of strut"@en ;
    dcterms:description "This probably is the record of the installation of the strut in 1685 CE (NS 805). The names of the donor and his father are mentioned in the inscription, but are unclear due to illegibility of the text."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/6700e6dc-ad31-11ea-8ae7-0242ac130005> ;
