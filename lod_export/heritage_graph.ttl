<https://data.cairnepal.org/heritage/resource/event/f7ee7e3d-05d2-4664-be56-f83a281613af_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Establishment of a caitya"@en ;
    dcterms:description "Thecaitya, now placed on top of the Shrine as its finial (see ‘description’ above) was established by Jagatasiṃ and Paṃdu at the premises of Rāma Bāhāḥ (text: ‘Raṃbāhāra’) during the reign of King Mahendra Malla."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f7ee7e3d-05d2-4664-be56-f83a281613af> ;
