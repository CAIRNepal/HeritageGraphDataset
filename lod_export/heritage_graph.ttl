    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6> .

<https://data.cairnepal.org/heritage/resource/event/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Reconstruction of the temple"@en ;
    dcterms:description "In the aftermath of the 1934 CE earthquakes, the temple underwent reconstruction under the direction of Prime Minister Juddha Śamśera. The rebuilding process took place eight years after the earthquakes. Notably, the new bricks used for reconstruction were inscribed with the words “Śrī 3 Juddha 1998,” signifying the restoration in the year 1941 CE (VS 1998)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6> ;
    rdfs:comment "In the aftermath of the 1934 CE earthquakes, the temple underwent reconstruction under the direction of Prime Minister Juddha Śamśera. The rebuilding process took place eight years after the earthquakes. Notably, the new bricks used for reconstruction were inscribed with the words “Śrī 3 Juddha 1998,” signifying the restoration in the year 1941 CE (VS 1998)."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 1 ;
