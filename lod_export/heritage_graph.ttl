<https://data.cairnepal.org/heritage/resource/event/49ef4ed5-f11e-4981-83ae-3e87185d784d_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "Candra Śamśera launched a project under the name \"Chandra Loka Water Works\" in the joint name of himself and his wife, Candralokabhakta Lakṣmī Devī. Colonel Kiśora Narasiṃha Rāṇā served as the executive engineer."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/49ef4ed5-f11e-4981-83ae-3e87185d784d> ;
    rdfs:comment "Candra Śamśera launched a project under the name \"Chandra Loka Water Works\" in the joint name of himself and his wife, Candralokabhakta Lakṣmī Devī. Colonel Kiśora Narasiṃha Rāṇā served as the executive engineer."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 0 ;
    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/49ef4ed5-f11e-4981-83ae-3e87185d784d> .

<https://data.cairnepal.org/heritage/resource/event/49ef4ed5-f11e-4981-83ae-3e87185d784d_1> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Recording of water project"@en ;
    dcterms:description "Further details about the objectives of constructing this tank in Kirtipur are not found here but in an inscription (KAT2841_I_003) at the Bagmati Bridge in Thapathali. Candra Śamśera, who rebuilt the Bagmati Bridge in a modern style, included details in this laudatory inscription about the project to supply water from Kirtipur to Patan. The inscription notes that while Kathmandu and Bhaktapur already had public water taps (kaladhārā), Patan lacked them, forcing residents to drink well water, which caused illness and weakness. In fulfillment of the resolve of his late wife, Candralokabhakta Lakṣmī Devī, water was brought to Patan through iron pipes from a location 19,900 feet away. Necessary reservoirs were constructed along the route, and a 300-foot-long bridge was built over the Bagmati to support the pipeline. The project resulted in 50 public water taps in Patan, with prayers that the merit would grant the late queen salvation and Candra Śamśera a 100-year lifespan. Thus, this tank was built as part of a major initiative by the prime minister and his wife to supply water to Patan."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/49ef4ed5-f11e-4981-83ae-3e87185d784d> ;
    rdfs:comment "Further details about the objectives of constructing this tank in Kirtipur are not found here but in an inscription (KAT2841_I_003) at the Bagmati Bridge in Thapathali. Candra Śamśera, who rebuilt the Bagmati Bridge in a modern style, included details in this laudatory inscription about the project to supply water from Kirtipur to Patan. The inscription notes that while Kathmandu and Bhaktapur already had public water taps (kaladhārā), Patan lacked them, forcing residents to drink well water, which caused illness and weakness. In fulfillment of the resolve of his late wife, Candralokabhakta Lakṣmī Devī, water was brought to Patan through iron pipes from a location 19,900 feet away. Necessary reservoirs were constructed along the route, and a 300-foot-long bridge was built over the Bagmati to support the pipeline. The project resulted in 50 public water taps in Patan, with prayers that the merit would grant the late queen salvation and Candra Śamśera a 100-year lifespan. Thus, this tank was built as part of a major initiative by the prime minister and his wife to supply water to Patan."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
