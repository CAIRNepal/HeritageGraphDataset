<https://data.cairnepal.org/heritage/resource/event/2c4ce775-72ec-4621-809f-77c137e58dfc_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of a sataḥ next to the Temple"@en ;
    dcterms:description "There are seven inscriptions embedded on a wall east of the Temple, as discussed in the 'description' above. The first, from 1697 CE (NS 817), records the construction of asataḥnext to the Temple by Vāsudeva Bhāro and Racherāma Bhāro. This demonstrates that the Temple itself existed prior to 1697 CE."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2c4ce775-72ec-4621-809f-77c137e58dfc> ;
