        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of a well"@en ;
    dcterms:description "A well was dug up southwest of thedyaḥchẽto provide drinking water for devotees visiting Manamāneśvarī for worship. This well was constructed in memory ofSaradāraKājilāla Pradhāna, a resident of Dhālāchẽ, Patan, by his descendants."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/34d3a0bc-bf6d-489e-b2a4-9bf09d771740> ;
