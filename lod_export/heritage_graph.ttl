<https://data.cairnepal.org/heritage/resource/event/2614a79c-5c54-4fe6-9020-209372f7f964_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the śivālaya"@en ;
    dcterms:description "Ḍirakumārīdevī, the wife of Dhīra Śamśera, erected Dīrabhakteśvara as an expression of her reverence to Lord Śiva. Additionally, she pledged to provide land parcels to generate income for the temple, covering the costs of daily and occasional rituals, as well as compensating the priest, cleaners, and musicians for their contributions to the temple."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2614a79c-5c54-4fe6-9020-209372f7f964> ;
