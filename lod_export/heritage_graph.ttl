<https://data.cairnepal.org/heritage/resource/event/9d5039d0-e979-11e9-8bc4-0242ac130002_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Completion of restoration"@en ;
    dcterms:description "A ceremony was held to celebrate the completion of the reconstruction work. Juddha Śamaśera, the Prime Minister of Nepal, was invited to participate in theMahā Ahorātra Yajña.The Prime Minister rebated the loan instantly and distributed cash prizes to the tutors, priests, and artisans. The temple was rebuilt on a slightly smaller scale after it was destroyed in the 1934 earthquake (Bernier1978, 75)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/9d5039d0-e979-11e9-8bc4-0242ac130002> ;
