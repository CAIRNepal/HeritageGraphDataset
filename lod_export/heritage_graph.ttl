<https://data.cairnepal.org/heritage/resource/event/4c31625e-ea78-11e9-8bc4-0242ac130002_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Replacement of the Mahiṣāsuramardinī statue"@en ;
    dcterms:description "The metal image of Mahiṣāsuramardinī on the eastern façade was added to replace one that had long been lost. The image of Mahiṣāsuramardinī placed in the spout was also lost, though this one was later found. However, a new image was installed after it went missing, and the original one is now kept in the museum."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/4c31625e-ea78-11e9-8bc4-0242ac130002> ;
