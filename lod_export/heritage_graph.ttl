<https://data.cairnepal.org/heritage/resource/event/c2add511-115d-4d83-bcef-db8ed170a594_2> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Installation of a copper inscription"@en ;
    dcterms:description "पाकशाला र वीरनारायण मन्दिरको वार्षिक कार्यका खातिर आय र खर्च व्यवस्थाको विस्तृत ताम्रपत्र अभिलेख लेखी पाकशालामा टाँसियो । यो अभिलेखीकरण कार्य श्री पूर्वतर्फका कमाण्डर जनरल धर्म शमशेर राणाका मर्जी मार्फत् नारामान भक्तले गरेका हुन् ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/c2add511-115d-4d83-bcef-db8ed170a594> ;
