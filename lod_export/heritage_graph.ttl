<https://data.cairnepal.org/heritage/resource/event/57c22b4c-559d-43bf-b9c6-417f669f4127_0> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Construction of Jitāpura Gaṃcā"@en ;
    dcterms:description "Jitāpurī (Jitāpura Gaṃcā) was constructed in Khokanā, the residence of the goddess Rudrāyaṇī, by a group of 38 individuals affiliated with three guṭhīs under the leadership of Siddhisiṃha Bhāvo. Responsibility for the maintenance and restoration of themaṇḍapa, in the event of damage or deterioration, was entrusted to these same threeguṭhīs. The construction took place during the tenure of Candravīra Siṃha Bhāro, who served as the Pradhan (chief administrator) of Khokanā."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/57c22b4c-559d-43bf-b9c6-417f669f4127> ;
    rdfs:comment "Jitāpurī (Jitāpura Gaṃcā) was constructed in Khokanā, the residence of the goddess Rudrāyaṇī, by a group of 38 individuals affiliated with three guṭhīs under the leadership of Siddhisiṃha Bhāvo. Responsibility for the maintenance and restoration of themaṇḍapa, in the event of damage or deterioration, was entrusted to these same threeguṭhīs. The construction took place during the tenure of Candravīra Siṃha Bhāro, who served as the Pradhan (chief administrator) of Khokanā."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 0 ;
