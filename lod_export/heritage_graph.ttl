    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/c2add511-115d-4d83-bcef-db8ed170a594> .

<https://data.cairnepal.org/heritage/resource/event/c2add511-115d-4d83-bcef-db8ed170a594_1> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Addition of a bell"@en ;
    dcterms:description "वीर शम्शेरका नाममा स्थापना भएको वीरनारायण मन्दिरमा उनकी कान्छी महारानीबाट एक घण्ट चढाइयो ।"@en ;
