<https://data.cairnepal.org/heritage/resource/event/6841ec23-0b12-4233-bada-cb6c1aa686e9_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Erecting lion pillar"@en ;
    dcterms:description "Astone pillar(SAG0010-008) has been erected directly in front of this temple, and alion statueis installed on top of it. Aninscriptionis carved on one side of the pillar. The date carved in the inscription, 'Sambata 2010' (VS 2010), is clear, but the other details are illegible, so the rest of the information mentioned in it is unknown."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/6841ec23-0b12-4233-bada-cb6c1aa686e9> ;
