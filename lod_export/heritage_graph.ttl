<https://data.cairnepal.org/heritage/resource/event/d642cefe-408c-4943-9405-b0aebe0d82a1_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the phalcā"@en ;
    dcterms:description "In June 2019 CE, thephalcāwas renovated and all wooden elements were painted. The project was initiated by Rājana KC, a parliamentarian from Kiripur, and funded by the Parliamentary Development Fund (Sāṃsada Vikāsa Koṣa/ सांसद विकास कोष)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d642cefe-408c-4943-9405-b0aebe0d82a1> ;
    rdfs:comment "In June 2019 CE, thephalcāwas renovated and all wooden elements were painted. The project was initiated by Rājana KC, a parliamentarian from Kiripur, and funded by the Parliamentary Development Fund (Sāṃsada Vikāsa Koṣa/ सांसद विकास कोष)."@en ;
