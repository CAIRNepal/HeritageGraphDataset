        hg:HistoricalEvent ;
    rdfs:label "Installation of an inscription"@en ;
    dcterms:description "Nine years after the issuance of thelālamohara, its contents were inscribed in a stone inscription placed next to the temple. The inscription also outlines the activities to be carried out from the income of the donated land parcels."@en ;
