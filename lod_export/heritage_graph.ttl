<https://data.cairnepal.org/heritage/resource/event/c764be19-d582-46ba-9cd6-c1a83bac0bcc_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Damage in earthquake and reconstruction"@en ;
    dcterms:description "Following its destruction in the earthquake of 1934 CE (VS 1990), the temple underwent reconstruction eleven years later and was built in its current form, mirroring the architectural style of the Vaṃśeśvara Temple (KAT1330) and Naudegaḥ (KAT1280)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/c764be19-d582-46ba-9cd6-c1a83bac0bcc> ;
