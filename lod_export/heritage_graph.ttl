<https://data.cairnepal.org/heritage/resource/event/168523f7-0f40-477f-87d9-820220ea2723_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction"@en ;
    dcterms:description "The temple was erected by Badrīnarasiṃha, the younger brother of Prime Minister Jaṅga Bahādura Rāṇā. While there is no inscription that records this event, a document (cf.K_0009_0011) from 1850 CE (VS 1907) attributes the construction of this temple, among others in the vicinity, to Badrīnarasiṃha."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/168523f7-0f40-477f-87d9-820220ea2723> ;
