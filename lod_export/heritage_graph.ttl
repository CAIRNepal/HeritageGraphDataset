        hg:Production ;
    rdfs:label "Inauguration of the reconstructed phalcā"@en ;
    dcterms:description "Following the completion of the reconstruction, Samay Phalcā was inaugurated by the mayor of Lalitpur. It was rebuilt at a total cost of NRs. 3.5 million."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/c6ce5cc1-ed5f-468a-90e7-4afe5d723128> ;
