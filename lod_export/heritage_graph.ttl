        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "Theśivaliṅgawas under the open sky until the present Temple structure was constructed in 1960 CE with the financial help from Dāmodara Śamśera Rāṇā."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/937f42c4-d4a7-41c8-b259-3272b9a37638> ;
