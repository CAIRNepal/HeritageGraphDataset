        hg:Production ;
    rdfs:label "Offering gilded patāḥ"@en ;
    dcterms:description "भतकुनि टोल (भकुंटोल) बस्ने कजि विष्णुदेवी र काजीमान दंगुले वत्सला मन्दिरमा सुनको मोलम्बा लगाइएको पता: चढाएका थिए । काजीमान, तुलसीमान लगायतका व्यक्तिहरूले मिलेर अरु पनि केही वस्तु चढाएका थिए । अभिलेख स्पष्ट नभएकोले को भाव बुझ्न गार्‍हो छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/32b21dd4-78f4-49a4-89ef-cec4b28c0f6b> ;
