<https://data.cairnepal.org/heritage/resource/event/d7e3c28c-e1ab-430b-9b2d-9b69475905a9_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the Phalcā"@en ;
    dcterms:description "The renovation of the dilapidated phalcā was undertaken byKvāṭhanāyakaḌhuṇḍirāja Bhāro, who also installed the idol of Umāmaheśvara in 1716 CE (NS 836). A guṭhī has been established, allocating land for conducting anniversary ritual on the day of Bhīmā Ekādaśī (Māghaśukla ekādaśī, day of renovation) as well as for the daily worship of the statue by Brāhmaṇa."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d7e3c28c-e1ab-430b-9b2d-9b69475905a9> ;
    rdfs:comment "The renovation of the dilapidated phalcā was undertaken byKvāṭhanāyakaḌhuṇḍirāja Bhāro, who also installed the idol of Umāmaheśvara in 1716 CE (NS 836). A guṭhī has been established, allocating land for conducting anniversary ritual on the day of Bhīmā Ekādaśī (Māghaśukla ekādaśī, day of renovation) as well as for the daily worship of the statue by Brāhmaṇa."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
