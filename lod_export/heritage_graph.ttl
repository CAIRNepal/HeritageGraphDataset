<https://data.cairnepal.org/heritage/resource/event/da9956e9-a637-4986-a017-0749a35f0f24_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Reconstruction of the sataḥ"@en ;
    dcterms:description "While the Sataḥ did not collapse in the 2015 earthquakes, it was deemed unsafe to live in. In 2022, it was completely demantled and consequently reconstructed. This was carried out by the High-Powered Committee for Integrated Development of the Bagmati Civilization under the Ministry of Urban Development with the loan assistance of the Asian Development Bank."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/da9956e9-a637-4986-a017-0749a35f0f24> ;
