<https://data.cairnepal.org/heritage/resource/event/f142c371-6fa0-4599-ad3f-8bd47469406e_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the temple"@en ;
    dcterms:description "The temple was constructed by Prime Minister Jaṅga Bahādura Rāṇā in VS 1931 (1875 CE). In the sanctum of the temple, he installed metal statues of Satyanārāyaṇa, Sarasvatī, and Lakṣmī. On the stone pillar in front of the temple, an inscription detailing the construction of the temple is carved, and on top of the pillar, a full-sized statue of Jaṅga Bahādura Rāṇā is placed."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f142c371-6fa0-4599-ad3f-8bd47469406e> ;
    rdfs:comment "The temple was constructed by Prime Minister Jaṅga Bahādura Rāṇā in VS 1931 (1875 CE). In the sanctum of the temple, he installed metal statues of Satyanārāyaṇa, Sarasvatī, and Lakṣmī. On the stone pillar in front of the temple, an inscription detailing the construction of the temple is carved, and on top of the pillar, a full-sized statue of Jaṅga Bahādura Rāṇā is placed."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
