<https://data.cairnepal.org/heritage/resource/event/b21b09ef-1998-4f1f-8e8b-ffe6b99f9116_4> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the Phalcā"@en ;
    dcterms:description "The Subāhāḥ Ṭola Sudhāra Samiti renovated the Phalcā with the help of the then Lalitpur Sub-Metropolitan City, UDL and local residents of the Subāhāḥ Ṭola. Old wood and bricks were used for restoration as much as possible."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/b21b09ef-1998-4f1f-8e8b-ffe6b99f9116> ;
