<https://data.cairnepal.org/heritage/resource/event/a2cfeca7-18cd-4ba6-8793-4390725a1375_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Damage in the earthquake"@en ;
    dcterms:description "The 2015 earthquakes inflicted substantial damage on the temple, leaving cracks throughout its structure. Despite the extensive cracking, the temple initially withstood the seismic forces."@en ;
