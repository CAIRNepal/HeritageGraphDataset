<https://data.cairnepal.org/heritage/resource/event/adad44a2-9ffc-4a05-ba82-ad6d39f10c17_4> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Establishment of Gaṇeśa , Nandī and Hanumān"@en ;
    dcterms:description "Bālakṛṣṇa Mānandhara, Lakṣmī Mānandhara, and Kubera Mānandhara, residents of Banepa, established statues of Gaṇeśa (NWK0650-008), Nandī (NWK0650-009), and Hanumān (NWK0650-010) south of the Kapileśvara Mandira in memory of their deceased parents Herābahādura and Santuku Mānandhara. They also installed a trident on the occasion."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/adad44a2-9ffc-4a05-ba82-ad6d39f10c17> ;
