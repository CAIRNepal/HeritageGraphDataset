    rdfs:label "Termite invasion"@en ;
    dcterms:description "Scores of termites were observed inside the Vajrayoginī Temple for two consecutive days. Following consultation with holy scriptures, special worship rituals for auspiciousness were conducted."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f5a48d0e-2f70-4721-abb2-614f7311dec9> ;
