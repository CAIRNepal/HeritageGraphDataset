<https://data.cairnepal.org/heritage/resource/event/23d40c88-efc0-4f8d-bb17-a50f831912f3_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction  of a dharmaśālā (phalcā)"@en ;
    dcterms:description "This inscription is embedded into the southern wall of the Temple and is not directly related to the Temple. It records the construction of aphalcāaround the place of Yamaleśvara. Moreover, this inscription also records the regulations laid down for organising the anniversary celebration of thephalcā."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/23d40c88-efc0-4f8d-bb17-a50f831912f3> ;
    rdfs:comment "This inscription is embedded into the southern wall of the Temple and is not directly related to the Temple. It records the construction of aphalcāaround the place of Yamaleśvara. Moreover, this inscription also records the regulations laid down for organising the anniversary celebration of thephalcā."@en ;
