        hg:DestructionEvent ;
    rdfs:label "Rebuilt"@en ;
    dcterms:description "The phalcā, which had fallen into disrepair, was reconstructed in 2012 CE (2069 VS) with the support of Bhaktapur Municipality, both financially and technically. Consequently, the earthquake of 2015 CE (2072 VS) did not cause any damage to the building."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/7947965c-44e3-4fc0-b14e-7d781f54dca2> ;
