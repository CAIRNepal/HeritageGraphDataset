<https://data.cairnepal.org/heritage/resource/event/147f9da8-5a54-438d-b51e-1d473f23b374_7> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the bāhāḥ"@en ;
    dcterms:description "Vajrācārya Tavadhika, his wife Cukuti and other family members renovated Bāhāḥ and offered pinnacle. At that time, Bhaktapur was under the joint rule of King Raṇajita Malla and his son Vīranarasiṃha Malla. Moreover, prohibition is made to keep goats, ducks and to weave the yarn and clean the pots."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/147f9da8-5a54-438d-b51e-1d473f23b374> ;
    rdfs:comment "Vajrācārya Tavadhika, his wife Cukuti and other family members renovated Bāhāḥ and offered pinnacle. At that time, Bhaktapur was under the joint rule of King Raṇajita Malla and his son Vīranarasiṃha Malla. Moreover, prohibition is made to keep goats, ducks and to weave the yarn and clean the pots."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
