    rdfs:label "Initial construction"@en ;
    dcterms:description "Together with her three sons, Gomatī commissioned this Pāṭī in memory of her husband."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2a0b1750-ee3e-11e9-8649-0242ac130002> ;
