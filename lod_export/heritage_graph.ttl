<https://data.cairnepal.org/heritage/resource/event/fffd4e1d-aa4c-46b3-bcbb-f181030c0f27_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Reconstruction of the temple"@en ;
