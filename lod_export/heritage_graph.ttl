<https://data.cairnepal.org/heritage/resource/event/467fda6f-8d18-47fa-a850-ccdfca7399c4_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "Dhammasiṃha Varuḍākāra and his wife Māratimayi, along with Devarāja and his unnamed wife established thecaitya. Additionally, Devarāja donated land parcels, one measuring 1ropanī7 and a halfjavawhile the other measuring 3ropanīs, to fund various rituals at thecaitya, including the lighting of lamps on the full moon day of Āśvina."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/467fda6f-8d18-47fa-a850-ccdfca7399c4> ;
