<https://data.cairnepal.org/heritage/resource/event/9a24d1d5-cec1-4a93-8d54-0d7f01695b57_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Collapse of the śikhara"@en ;
    dcterms:description "Based on extant historical photographs, it becomes evident that the upper section of the temple experienced considerable damage due to seismic activity, prompting subsequent reconstruction efforts. The documented images portray the aftermath of the earthquakes and the subsequent renewal endeavors undertaken to reinstate the temple's architectural integrity."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/9a24d1d5-cec1-4a93-8d54-0d7f01695b57> ;
