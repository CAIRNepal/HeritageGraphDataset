    rdfs:label "Renovation of the Phalcā"@en ;
    dcterms:description "The Phalcā was renovated: It was plastered with cement and its roof was replaced with corrugated metal sheets."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/3a781560-86b0-11ea-86ac-0242ac130005> ;
