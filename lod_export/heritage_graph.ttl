<https://data.cairnepal.org/heritage/resource/event/2af3fc6d-7bc2-4922-b562-7232446814f0_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Installation of an inscription"@en ;
    dcterms:description "An inscription was installed, recording the offering of a gilded finial, parasol, and roof after the construction of the temple. The new inscription quoted the events from earlier inscriptions recording the construction of the temple in 1877 CE (NS 997) and laying of gilded sheet on the roof in 1881 CE (NS 1001)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2af3fc6d-7bc2-4922-b562-7232446814f0> ;
    rdfs:comment "An inscription was installed, recording the offering of a gilded finial, parasol, and roof after the construction of the temple. The new inscription quoted the events from earlier inscriptions recording the construction of the temple in 1877 CE (NS 997) and laying of gilded sheet on the roof in 1881 CE (NS 1001)."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 2 ;
