<https://data.cairnepal.org/heritage/resource/event/0a006229-7e08-4cb2-9883-1527f615bbfb_15> a crm:E5_Event,
        hg:ConditionAssessment ;
    rdfs:label "Offering of a bell"@en ;
    dcterms:description "On this day, a bell was offered to the temple. The fact that there was a large bell inside the temple is known from a survey conducted by Surendra Jośī in 1977 CE."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/0a006229-7e08-4cb2-9883-1527f615bbfb> ;
