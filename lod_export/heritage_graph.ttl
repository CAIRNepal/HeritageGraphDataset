<https://data.cairnepal.org/heritage/resource/event/7386096b-0e01-4d96-b18b-d529d4e97b2f_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Addition of lions"@en ;
    dcterms:description "Outside thedevalahousing the image of Akṣobhya stands a pair of lion sculptures bearing the name “Ratnākara.” The sculptures record only the name of the founder and do not include a date. Since such lion figures typically form an integral architectural component of the shrine, it is likely that they were installed at the same time as the construction of thebāhāḥin 1924–25 (VS 1981).अक्षोभ्यको मूर्ति राखिएको देवल बाहिर एक जोडा सिंहप्रतिमा छन् जसमा ‘रत्नाकर’ लेखिएको छ । यस बाहाःका नर्माताको मात्र नाम परी यसमा मिति उल्लेख भएको छैन । देवलमा एकै अङ्गको रूपमा द्वारपालका प्रतिमा निर्माण हुने भएकाले यो बाहाःसँगै विसं १९८१ (सन् १९२४-२५) मै बनेको बुझिन्छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/7386096b-0e01-4d96-b18b-d529d4e97b2f> ;
    rdfs:comment "Outside thedevalahousing the image of Akṣobhya stands a pair of lion sculptures bearing the name “Ratnākara.” The sculptures record only the name of the founder and do not include a date. Since such lion figures typically form an integral architectural component of the shrine, it is likely that they were installed at the same time as the construction of thebāhāḥin 1924–25 (VS 1981).अक्षोभ्यको मूर्ति राखिएको देवल बाहिर एक जोडा सिंहप्रतिमा छन् जसमा ‘रत्नाकर’ लेखिएको छ । यस बाहाःका नर्माताको मात्र नाम परी यसमा मिति उल्लेख भएको छैन । देवलमा एकै अङ्गको रूपमा द्वारपालका प्रतिमा निर्माण हुने भएकाले यो बाहाःसँगै विसं १९८१ (सन् १९२४-२५) मै बनेको बुझिन्छ ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 1 ;
    hg:extractionMethod "source_table" ;
