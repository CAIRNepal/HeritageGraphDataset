        hg:DestructionEvent ;
    rdfs:label "Minor reparations"@en ;
    dcterms:description "Due to the continuous rainfall of the monsoon season, the roof was damaged and began to leak water under thephalcā. The roof was repaired once the monsoon ended."@en ;
