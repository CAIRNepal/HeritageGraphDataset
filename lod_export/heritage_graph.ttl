        hg:DestructionEvent ;
    rdfs:label "Damage by earthquake"@en ;
    dcterms:description "During the 2015 earthquakes, the Vajrayoginī Temple sustained multiple cracks but fortunately did not collapse. To prevent further damage or collapse, wooden supports were placed all around the temple."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f5a48d0e-2f70-4721-abb2-614f7311dec9> ;
