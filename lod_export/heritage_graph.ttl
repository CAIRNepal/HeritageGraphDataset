<https://data.cairnepal.org/heritage/resource/event/f96c7cf2-e923-11e9-b125-0242ac130002_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction of the temple"@en ;
    dcterms:description "In 1576 CE (NS 696), Luṃgu Bhāro built this temple in memory of his late grandson Deva Bhāro. Luṃgu Bhāro first visited Kashi (Varanasi) and established a statue of Umāmaheśvara on the wall of the Siddheśvarī temple there. After returning from Kashi, he built Gajendramokṣa Nārāyaṇa Mandira."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f96c7cf2-e923-11e9-b125-0242ac130002> ;
