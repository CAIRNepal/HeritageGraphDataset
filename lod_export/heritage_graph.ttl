<https://data.cairnepal.org/heritage/resource/event/425bbdb8-54b5-474e-839a-7da85f116aa3_0> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Endowment of lands"@en ;
    dcterms:description "Heranī Mayī, a resident of the Pasiṃkochẽ Ṭola northeast of Cāpāgāũ, established a religious trust by donating eightropanīs of land to Vajravārāhī. The income from the land was designated for donating various items, including puffed rice, beaten rice, curd, meat, and fermented beer, during the processions in Caitra and Kārtika. Lamps were also to be lit on these occasions. The trust was further obligated to annually feedjogis and make special offerings to them on the new moon day of Bhadra."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/425bbdb8-54b5-474e-839a-7da85f116aa3> ;
    rdfs:comment "Heranī Mayī, a resident of the Pasiṃkochẽ Ṭola northeast of Cāpāgāũ, established a religious trust by donating eightropanīs of land to Vajravārāhī. The income from the land was designated for donating various items, including puffed rice, beaten rice, curd, meat, and fermented beer, during the processions in Caitra and Kārtika. Lamps were also to be lit on these occasions. The trust was further obligated to annually feedjogis and make special offerings to them on the new moon day of Bhadra."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 0 ;
