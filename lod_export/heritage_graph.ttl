        hg:DestructionEvent ;
    rdfs:label "Reconstruction"@en ;
    dcterms:description "Following its complete collapse due to the devastating earthquakes in 2015 CE, the temple was reduced to rubble. Subsequently, the Department of Archaeology undertook its reconstruction, completing the restoration efforts in 2017 CE (VS 2074)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/56bfc1ff-204d-452c-8c3c-fda34dadc1e1> ;
