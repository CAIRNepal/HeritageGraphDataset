<https://data.cairnepal.org/heritage/resource/monument/e7ad4210-ca99-11e9-b993-0242ac140002> a crm:E22_Human-Made_Object,
        hg:ArchitecturalStructure,
        hg:Pati ;
    rdfs:label "Dabū Phalcā (1704 CE)"@en ;
    dcterms:identifier "e7ad4210-ca99-11e9-b993-0242ac140002" ;
    dcterms:references "Sources and references Sources Inscription of NS 824 Details १.  ॐनमः शिवाय ।। नमः शवित्रे जगदेकचक्षुक्षजगताप्रस्ण २. ती,अस्थितनागेहेतवेअसत्रुणीमयायी,असत्रुगणा ३. गधालिने, विलिञ्चि नारायण्ां शंकरातुमन्ननस ।। ।। ४. श्रेयाोऽस्तु ।। सम्वत् ८२४ वैशाष शुक्ल ।। द्वितियायान्तिथौ । कृ– ५. तिकानक्षत्र ।। श्राभनयोग ।। सोमवार ।। थ्व कुन्हु फले, दबुरि ६. दयकं ः श्री ३ करुणामय प्रीतिन दयका जुरो ।। श्री श्री जय ७. वीर योगनलेन्द्र मल्ल देवया प्रज्यायस धोपोगात्र व– ८. लिपछेया, नरहरि भारो भाय्र्या वसुमुनिजु, स्त्रिपुरुषन ९. फरे, दबुरि, दयकं प्रतिष्ठा याङा दिन जुरो ।। शुभं ।। १०. सुनान सेनकरसा पञ्चमहापातक राक जुरो ।। शुभं ।।"@en ;
    dcterms:title "Dabū Phalcā (1704 CE)"@en ;
    crm:P12i_was_present_at <https://data.cairnepal.org/heritage/resource/event/e7ad4210-ca99-11e9-b993-0242ac140002_0>,
        <https://data.cairnepal.org/heritage/resource/event/e7ad4210-ca99-11e9-b993-0242ac140002_1>,
        <https://data.cairnepal.org/heritage/resource/event/e7ad4210-ca99-11e9-b993-0242ac140002_2>,
