    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/a2cfeca7-18cd-4ba6-8793-4390725a1375> .

<https://data.cairnepal.org/heritage/resource/event/a32d51f6-544b-42f6-b432-481d4632c08d_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation"@en ;
    dcterms:description "The Shankharapur Municipality renovated the Jaḥdhuṃhiti. In the process, the position of the Licchavi Caityas was changed and the stone ceremonial mirror (jvalānhāykaṃ) and a broken piece of a finial were installed as the finial of the Caityas (see the description above for more information)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/a32d51f6-544b-42f6-b432-481d4632c08d> ;
    rdfs:comment "The Shankharapur Municipality renovated the Jaḥdhuṃhiti. In the process, the position of the Licchavi Caityas was changed and the stone ceremonial mirror (jvalānhāykaṃ) and a broken piece of a finial were installed as the finial of the Caityas (see the description above for more information)."@en ;
