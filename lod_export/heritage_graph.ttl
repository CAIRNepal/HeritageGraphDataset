<https://data.cairnepal.org/heritage/resource/event/ad08a0da-dad2-4e48-a61f-399a681fcfdc_0> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Renovation of the monument"@en ;
    dcterms:description "Thebāhāḥ, which sustained damage in the earthquake of 1934, was repaired in the aftermath of that disaster.सन् १९३४ को भूकम्पमा क्षति पुगेको बाहाःलाई भूकम्प पश्चात् मर्मतकार्य गरिएको थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/ad08a0da-dad2-4e48-a61f-399a681fcfdc> ;
