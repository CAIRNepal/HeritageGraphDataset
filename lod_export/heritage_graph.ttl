        hg:DestructionEvent ;
    rdfs:label "Damage suffered"@en ;
    dcterms:description "The roofs of the temple leaked due to the lack of timely maintenance. A photo of the temple from 2014 CE shows its roofs covered by tarpaulin to prevent leakages."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/59d6dc2c-0301-4423-8255-82e93892922b> ;
