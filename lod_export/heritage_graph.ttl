<https://data.cairnepal.org/heritage/resource/event/12f3faf5-d915-4a52-a73d-f19bd71e411a_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Rebuilding the Temple"@en ;
    dcterms:description "In the beginning of the 2000s, the rebuilding of the temple in its original form was carried out in consultation with the Department of Archaeology (DoA). The DoA covered half of the expenses and the other half was raised from the local residents, who also provided free labour."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/12f3faf5-d915-4a52-a73d-f19bd71e411a> ;
