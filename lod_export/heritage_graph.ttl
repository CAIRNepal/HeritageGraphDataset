    hg:eventIndex 0 ;
    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/2f6ff45c-890f-4b5f-9c44-864b0b71ca7d> .

<https://data.cairnepal.org/heritage/resource/event/2f6ff45c-890f-4b5f-9c44-864b0b71ca7d_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "Budhanilkantha Municipality aimed for the reconstruction of the shrine on a grand scale. In accordance with this goal, construction was completed in 2024 CE (VS 2081), and the new temple was inaugurated by former President Bidya Devī Bhaṇḍarī. The previous structure, simply built of brick, has been entirely transformed into a stone temple ofśikharastyle. In the new temple, an attempt has been made to replicate the architectural design of the Siddhikālī temple (BKT0110) in Bhaktapur."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2f6ff45c-890f-4b5f-9c44-864b0b71ca7d> ;
    rdfs:comment "Budhanilkantha Municipality aimed for the reconstruction of the shrine on a grand scale. In accordance with this goal, construction was completed in 2024 CE (VS 2081), and the new temple was inaugurated by former President Bidya Devī Bhaṇḍarī. The previous structure, simply built of brick, has been entirely transformed into a stone temple ofśikharastyle. In the new temple, an attempt has been made to replicate the architectural design of the Siddhikālī temple (BKT0110) in Bhaktapur."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
