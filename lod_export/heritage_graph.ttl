        hg:DestructionEvent ;
    rdfs:label "Repair of vihāra"@en ;
    dcterms:description "To protect the temple from damage caused by heat and rain, local people and artisans working under the Mahābuddha Mandir Saṃrakṣaṇa Samiti repaired some of the images."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/9d5039d0-e979-11e9-8bc4-0242ac130002> ;
