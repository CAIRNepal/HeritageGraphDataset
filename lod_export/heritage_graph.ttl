        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the temple"@en ;
    dcterms:description "A significant renovation was carried out in 1963 CE. During this renovation, the brick face of the stepped plinth was replaced with red-colored cement mortar, and the face of the sanctum was also renewed."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/0a006229-7e08-4cb2-9883-1527f615bbfb> ;
