    rdfs:label "Addition of a bell"@en ;
    dcterms:description "Bhājumāṃ and other family members jointly offered a bell in the name of Mañjeśvarī (Mañjuśrī)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/b071cb98-09af-42ce-8334-6ea037aacb5e> ;
