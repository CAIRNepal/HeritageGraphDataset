<https://data.cairnepal.org/heritage/resource/event/5f218d0a-4412-11ea-a19a-0242ac130006_5> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation or restoration? of the temple"@en ;
    dcterms:description "The earliest record found in the temple is of NS 776 (1656 CE). This date is engraved at the bottom of a strut which used to be part of the lower roof. However, it is not clear whether the date inscribed refers to the original construction or to a restoration effort."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5f218d0a-4412-11ea-a19a-0242ac130006> ;
