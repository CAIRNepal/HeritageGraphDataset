        hg:DestructionEvent ;
    rdfs:label "Collapse of the dyaḥchẽ"@en ;
    dcterms:description "Thedyaḥchẽ(main building of thebāhāḥ) gave way and as a result, the sculptures depicting the principal deity and the enigmaticāgaṃdyaḥdeity were buried beneath the debris."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/a9dcf214-13cc-4b71-8b0c-488ff996713b> ;
