<https://data.cairnepal.org/heritage/resource/event/6a263bd4-6022-48bd-ba52-b730dd67710c_1> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Reconstruction of the Phalcā"@en ;
    dcterms:description "The Kirtipur Municipality reconstructed the phalcā and the attached shrine in 2020 CE. Only the stone plinth is original."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/6a263bd4-6022-48bd-ba52-b730dd67710c> ;
