        hg:HistoricalEvent ;
    rdfs:label "Installation of a Sarasvatī Statue (B)"@en ;
    dcterms:description "As mentioned in the first historical event, this inscription from NS 567 (1447 CE), too, records the installation of a Sarasvatī statue. However, it can not be identified whether the present-day Sarasvatī statue in the sanctum was installed in the earlier or this date."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/443544db-8f01-4d16-8f90-1de79f599e98> ;
