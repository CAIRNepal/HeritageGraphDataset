<https://data.cairnepal.org/heritage/resource/event/443544db-8f01-4d16-8f90-1de79f599e98_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Starting the Daily Worship"@en ;
    dcterms:description "A Karmācārya’s clan, living in Sundhārā, Patan started performing the daily worship in the temple in 2014 CE. The clan was requested to take over this responsiblity by Sarasvatī Ṭola Development Committee, a local and non-governmental organisation formed to develop and maintain the local area."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/443544db-8f01-4d16-8f90-1de79f599e98> ;
