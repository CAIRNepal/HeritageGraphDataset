<https://data.cairnepal.org/heritage/resource/event/54612871-717c-41e1-9a91-cf77d1267bad_13> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Erection of a lion pillar"@en ;
    dcterms:description "Centering around thepīṭha, a pillar was erected and a lion statue installed atop it. This act was jointly carried out by Indrarāja Jośī, Prakāaś Maharjan, and Alifa Ḍaṅgol, residents of Tokha, in the names of their respective deceased family members."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/54612871-717c-41e1-9a91-cf77d1267bad> ;
