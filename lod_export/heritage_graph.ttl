<https://data.cairnepal.org/heritage/resource/event/cc0b67f5-5907-4b7a-8283-9fffb779ba91_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Establishment of 21 water spouts"@en ;
    dcterms:description "The last king of Kathmandu, Jaya Prakāśa Malla, originally constructed 21 water spouts. No inscriptional record has been found regarding the construction of thishiti(water spout complex). However, it is known that it was built during his reign (1750–1768 CE).काठमाडौको अन्तिम राजा जयप्रकाश मल्लले प्रारम्भमा २१ वटा धाराको निर्माण  गरेका थिए । यस क्षेत्रमा हिति निर्माण सम्बन्धी कुनै अभिलेख प्राप्त छैन । उनको शासनकाल (सन् १७५०- १७६८) मा यो हितिको निर्माण भएको थाहा हुन्छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/cc0b67f5-5907-4b7a-8283-9fffb779ba91> ;
    rdfs:comment "The last king of Kathmandu, Jaya Prakāśa Malla, originally constructed 21 water spouts. No inscriptional record has been found regarding the construction of thishiti(water spout complex). However, it is known that it was built during his reign (1750–1768 CE).काठमाडौको अन्तिम राजा जयप्रकाश मल्लले प्रारम्भमा २१ वटा धाराको निर्माण  गरेका थिए । यस क्षेत्रमा हिति निर्माण सम्बन्धी कुनै अभिलेख प्राप्त छैन । उनको शासनकाल (सन् १७५०- १७६८) मा यो हितिको निर्माण भएको थाहा हुन्छ ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 0 ;
