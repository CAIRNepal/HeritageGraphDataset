<https://data.cairnepal.org/heritage/resource/event/f771b0b6-0d77-4d03-9578-ddef947a93f6_4> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Repair of the shrine"@en ;
    dcterms:description "Thedevasthalawas repaired with the financial support of Dhirjadāsa Rājakarṇikāra of Maru Tole, Kathmandu, and his family. This work was carried out through the coordinated efforts of both the Rājakarṇikāra Śaraṇa Guṭhī and the Rājakarṇikāra Samāja.काठमाडौं, मरु टोल निवासी धिर्जदास राजकर्णिकार र उनको परिवारको आर्थिक सहयोगमा देवस्थल मर्मत गरिएको थियो । उक्त काममा राजकर्णिकार शरण गुठी र राजकर्णिकार समाज दुबै संस्थाले समन्वय गरेको थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f771b0b6-0d77-4d03-9578-ddef947a93f6> ;
