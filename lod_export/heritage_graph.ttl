<https://data.cairnepal.org/heritage/resource/event/313ebade-3b32-4491-845d-fe5520f8622c_12> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Reconstruction of the temple"@en ;
    dcterms:description "The Pashupati Area Development Trust rebuilt the temple at a cost of NRs. 31.4 million. Some of the locals protested against the use of lime and brick-powder mortar during the reconstruction. Later, only clay mortar was used."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/313ebade-3b32-4491-845d-fe5520f8622c> ;
    rdfs:comment "The Pashupati Area Development Trust rebuilt the temple at a cost of NRs. 31.4 million. Some of the locals protested against the use of lime and brick-powder mortar during the reconstruction. Later, only clay mortar was used."@en ;
