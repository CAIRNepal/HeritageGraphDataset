    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/24001b17-8be8-4a56-82b4-e4191db787ec> .

<https://data.cairnepal.org/heritage/resource/event/24001b17-8be8-4a56-82b4-e4191db787ec_1> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Establishment of a guṭhī"@en ;
    dcterms:description "A signboard is positioned against the wall in the west wing, detailing the establishment of Bambeer Bikateshwar Shiavalaya Guthi by Bamabahādura Kũvara Rāṇā, the builder of the Tīna Devala temple,sataḥs, and other surrounding monuments."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/24001b17-8be8-4a56-82b4-e4191db787ec> ;
