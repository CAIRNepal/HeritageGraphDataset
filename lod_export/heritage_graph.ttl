<https://data.cairnepal.org/heritage/resource/event/95ae1a0f-e0e0-42bf-8101-4507d5462b17_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Repair of the monument"@en ;
    dcterms:description "According to the inscription, the building was built by the Shri Guru Nanak Dev Sewa Society International, based in El Sobrante, California.However, according the the Mahārāja of the Guru Nānaka Ghara, the building was only repaired rather than built new in early 2015 CE."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/95ae1a0f-e0e0-42bf-8101-4507d5462b17> ;
