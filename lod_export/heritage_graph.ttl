<https://data.cairnepal.org/heritage/resource/event/2e0a687f-2053-46ae-8820-79763e8fa06d_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Rebuilt"@en ;
    dcterms:description "The Paśupatī Area Development Trust has undertaken the reconstruction of the Śivālaya in 2019 CE (2076 VS).पशुपति क्षेत्र विकाष कोषले विसं २०७६ (सन् २०१९) मा यसको पुनर्निर्माण गरेको थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2e0a687f-2053-46ae-8820-79763e8fa06d> ;
