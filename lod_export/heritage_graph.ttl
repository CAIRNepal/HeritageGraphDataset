<https://data.cairnepal.org/heritage/resource/event/c6ce5cc1-ed5f-468a-90e7-4afe5d723128_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Decision taken to rebuild the phalcā"@en ;
    dcterms:description "In 2020 CE, a reconstruction committee was established; however, the commencement of work was impeded by a protracted legal battle to obtain official permission."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/c6ce5cc1-ed5f-468a-90e7-4afe5d723128> ;
