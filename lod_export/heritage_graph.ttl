<https://data.cairnepal.org/heritage/resource/event/5c063668-e5f6-11e9-b125-0242ac130002_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Collapse of the pura (tower)"@en ;
    dcterms:description "The pagoda style tower (pura) collapsed in the Great Earthquake of 1934 CE. The arcade survived (Gutschow 2011, 641). A few months later, the tower was replaced in a contemporary style."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5c063668-e5f6-11e9-b125-0242ac130002> ;
    rdfs:comment "The pagoda style tower (pura) collapsed in the Great Earthquake of 1934 CE. The arcade survived (Gutschow 2011, 641). A few months later, the tower was replaced in a contemporary style."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
