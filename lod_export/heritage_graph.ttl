        hg:DestructionEvent ;
    rdfs:label "Renovation of the Temple"@en ;
    dcterms:description "The 1934 earthquakes destroyed the Temple and was renovated by a person named Harikṛṣṇa Dvāre (Pruscha 1975, p. 265)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/7fd5e55f-876c-48f9-b974-357b58fec2c3> ;
