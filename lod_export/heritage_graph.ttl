<https://data.cairnepal.org/heritage/resource/event/8f639858-8eec-11ea-8e56-0242ac130005_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Theft of Gandhurī Devatā"@en ;
    dcterms:description "Thieves stole the clay and gold idol of Buddha. They took out the gilded plates and left the clay part on the road. The clay was found four days after the theft. After some time, a new idol was made by carrying new clay from Mhepi of Kathmandu and mixing it with the old clay."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/8f639858-8eec-11ea-8e56-0242ac130005> ;
