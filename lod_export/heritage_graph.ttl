<https://data.cairnepal.org/heritage/resource/event/03450b1b-4e03-4331-a079-202719840a5c_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of a sataḥ"@en ;
    dcterms:description "Members of the same temple-building family later constructed asataḥnear the temple. According to the inscription, the construction work began in 1882 CE (NS 1002) and was completed one year later.मन्दिर निर्माता परिवारबाटै मन्दिर नजिकै एक सतः बनाउने कार्य भयो । नेसं १००२ मा निर्माण कार्य थालिएको थियो भने एक वर्ष पश्चात् समापन भएको कुरा अभिलेखको अन्तमा भनिएको छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/03450b1b-4e03-4331-a079-202719840a5c> ;
    rdfs:comment "Members of the same temple-building family later constructed asataḥnear the temple. According to the inscription, the construction work began in 1882 CE (NS 1002) and was completed one year later.मन्दिर निर्माता परिवारबाटै मन्दिर नजिकै एक सतः बनाउने कार्य भयो । नेसं १००२ मा निर्माण कार्य थालिएको थियो भने एक वर्ष पश्चात् समापन भएको कुरा अभिलेखको अन्तमा भनिएको छ ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
