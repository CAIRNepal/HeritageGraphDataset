<https://data.cairnepal.org/heritage/resource/event/e499ec9a-e66e-11e9-8bc4-0242ac130002_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of Nāmasaṅgīti Phalcā"@en ;
    dcterms:description "According to the inscription, Nāmasaṅgīti Phalcā was renovated as to its previous structure had been standing in ruins. Kisna (Kṛṣṇa) Bhāro, Gusiṃha Bhāro, Jevanarāja Bhāvo, Gusiṃha Bhāvo, Mālasiñ Bhāvo and Hākudeva Bhāvo jointly contributed to its renovation."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/e499ec9a-e66e-11e9-8bc4-0242ac130002> ;
