<https://data.cairnepal.org/heritage/resource/event/cbae4fa5-4717-4c6c-9b34-eb8d696a09ba_5> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the Kaṅgaḥdyaḥ Shrine"@en ;
    dcterms:description "The Kaṅgaḥdyaḥ Shrine (see object number LAL1790-009 above) is under reconstruction (as of December 2020) by the joint efforts of Caḥpata Sampadā Saṃrakṣaṇa Samiti (a non-government organisation formed to develop the local heritage) and Caḥpata Ṭola Reform Committee (also a non-government organisation formed to develop Caḥpata Ṭola). A person called Mukeśa Maharjana drafted a roadmap and a design for its reconstruction."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/cbae4fa5-4717-4c6c-9b34-eb8d696a09ba> ;
