<https://data.cairnepal.org/heritage/resource/event/0232aa9c-821a-4872-ad21-af13cac95b0b_4> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Enforcement of rules re. forced labor"@en ;
    dcterms:description "This royal decree of King Rājendra Vikrama Śāha inscribed on a copper plate contains explicit instructions to Bhaktapur's local officials regarding two key provisions: the strict prohibition of exemptions fromjhara(forced labor obligations) and the organization and payment ofjharaduties for postal transportation services, to be managed by the 24ṭolas and their 24 designated chiefs."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/0232aa9c-821a-4872-ad21-af13cac95b0b> ;
    rdfs:comment "This royal decree of King Rājendra Vikrama Śāha inscribed on a copper plate contains explicit instructions to Bhaktapur's local officials regarding two key provisions: the strict prohibition of exemptions fromjhara(forced labor obligations) and the organization and payment ofjharaduties for postal transportation services, to be managed by the 24ṭolas and their 24 designated chiefs."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
