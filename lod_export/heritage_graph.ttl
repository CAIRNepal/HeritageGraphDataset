        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "Harinasī and his family from Thaiba built a temple for the Sthānagaṇeśa. They also set up a religious trust by donating land parcels to fund expenses for various rituals at the temple and for its timely renovations."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2af3fc6d-7bc2-4922-b562-7232446814f0> ;
