<https://data.cairnepal.org/heritage/resource/event/4cddce02-638a-4290-aa8c-41188deed1de_0> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Land endowment"@en ;
    dcterms:description "विसं १९३१ (सन् १८७४-७५) मा राजा सुरेन्द्रबाट जारी एक लालमोहरमा काशीनाथले बनाएको सतःका खातिर ४ रोपनी जग्गादान सिफारिस भएको थियो । यस प्रसंगबाट यस मिति अगावै यहाँ सतःहरू बनिसकेको तथ्य खुलदछ (K_0021_0016) ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/4cddce02-638a-4290-aa8c-41188deed1de> ;
