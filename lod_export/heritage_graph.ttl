    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/1347d2d6-66e1-4884-bc56-a2286a68d4e8> .

<https://data.cairnepal.org/heritage/resource/event/1347d2d6-66e1-4884-bc56-a2286a68d4e8_2> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Land endowment"@en ;
    dcterms:description "Siddhi Tāmrākāra and others from Garakuta, the courtyard in front (west) of Kavīndrapura now known as Gaḥkuti, endowed land to set up a trust (guthi) in the name of Dvibhujasamvara, their lineage deity."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/1347d2d6-66e1-4884-bc56-a2286a68d4e8> ;
    rdfs:comment "Siddhi Tāmrākāra and others from Garakuta, the courtyard in front (west) of Kavīndrapura now known as Gaḥkuti, endowed land to set up a trust (guthi) in the name of Dvibhujasamvara, their lineage deity."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
