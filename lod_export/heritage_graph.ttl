<https://data.cairnepal.org/heritage/resource/event/5790676a-4be7-439e-9904-f6521699b024_14> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "An Inscription in Licchavi Script"@en ;
    dcterms:description "An inscription in Licchavi script is carved on the pedestal (pādapīṭha) of the Gaṇeśa image installed within the Chinnamastā Temple. The inscription is undated and contains only the phrase:oṃ prāṇadhāra śarmmesyaḥ.छिन्नमस्ता मन्दिरभित्र स्थापना गरिएको गणेश मूर्तिको पादपीठमा लिच्छवि लिपिमा यो अभिलेख कुँदिएको छ । अभिलेखमा तिथिमिति छैन, केवलॐ प्राणधार शर्मेस्यःमात्र लेखिएको छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5790676a-4be7-439e-9904-f6521699b024> ;
    rdfs:comment "An inscription in Licchavi script is carved on the pedestal (pādapīṭha) of the Gaṇeśa image installed within the Chinnamastā Temple. The inscription is undated and contains only the phrase:oṃ prāṇadhāra śarmmesyaḥ.छिन्नमस्ता मन्दिरभित्र स्थापना गरिएको गणेश मूर्तिको पादपीठमा लिच्छवि लिपिमा यो अभिलेख कुँदिएको छ । अभिलेखमा तिथिमिति छैन, केवलॐ प्राणधार शर्मेस्यःमात्र लेखिएको छ ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
