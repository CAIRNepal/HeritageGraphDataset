<https://data.cairnepal.org/heritage/resource/event/eb39f614-f5f5-48c4-a130-f5edba72e5b5_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "Kājī Marīcamānasiṃha constructed the water spout to honor the wish of his late father, Kājī Balavānasiṃha (text: Balavānsi). Balavānasiṃha had planned to build a water spout at Baṭārabajāra square but passed away before he could accomplish this goal."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/eb39f614-f5f5-48c4-a130-f5edba72e5b5> ;
