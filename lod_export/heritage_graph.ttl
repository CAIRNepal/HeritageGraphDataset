<https://data.cairnepal.org/heritage/resource/event/54903008-fc04-46aa-92ac-9b991108224b_2> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Reconstruction of the temple"@en ;
    dcterms:description "Before the 2015 earthquakes, this temple was in a state of disrepair: a small tree had grown on its roof, and cracks had emerged on the walls, causing thetoraṇas to deteriorate. The Department of Archaeology (DoA) undertook the reconstruction of the temple around 2013 CE."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/54903008-fc04-46aa-92ac-9b991108224b> ;
