<https://data.cairnepal.org/heritage/resource/event/d292d972-7a85-4e3e-8af6-75db779adaab_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of a new phalcā"@en ;
    dcterms:description "The Kirtipur municipality planned to rebuilt a phalcā at the same place and funded Rs. 23, 64,000 to built a new phalcā in 2020 CE. The construction task was completed in 2020 September and inaugurated by the Mayor of the municipality on the 30th day of November 2020."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d292d972-7a85-4e3e-8af6-75db779adaab> ;
    rdfs:comment "The Kirtipur municipality planned to rebuilt a phalcā at the same place and funded Rs. 23, 64,000 to built a new phalcā in 2020 CE. The construction task was completed in 2020 September and inaugurated by the Mayor of the municipality on the 30th day of November 2020."@en ;
