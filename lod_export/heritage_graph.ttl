<https://data.cairnepal.org/heritage/resource/event/bf182f12-6d0a-4fd9-b0bc-228d66eb7f76_2> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Beginning of reconstruction"@en ;
    dcterms:description "The reconstruction of the temple began after the minister for Culture, Tourism, and Civil Aviation laid the foundation stone in early June 2022 CE (VS 2079) years after its collapse in 2015 CE. The government has allocated a budget of NRs. 450 thousand for the reconstruction of the temple as well as the rest houses at the premises."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/bf182f12-6d0a-4fd9-b0bc-228d66eb7f76> ;
