    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6> .

<https://data.cairnepal.org/heritage/resource/event/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6_2> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Restoration of the temple"@en ;
    dcterms:description "The temple restoration was made possible through funding from the US Ambassadors Fund for Cultural Preservation. The temple was restored in a collaborative effort between the Department of Archaeology, the Kathmandu Metropolitan City and the Kathmandu Valley Preservation Trust (KVPT).Guided by historical photographs the temple's original appearance prior to the 1934 CE earthquakes was recreated."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6> ;
    rdfs:comment "The temple restoration was made possible through funding from the US Ambassadors Fund for Cultural Preservation. The temple was restored in a collaborative effort between the Department of Archaeology, the Kathmandu Metropolitan City and the Kathmandu Valley Preservation Trust (KVPT).Guided by historical photographs the temple's original appearance prior to the 1934 CE earthquakes was recreated."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
