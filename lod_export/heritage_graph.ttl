        hg:DestructionEvent ;
    rdfs:label "Collapse of the monument"@en ;
    dcterms:description "The tower collapsed again in the 1934 earthquakes. It broke into a few pieces and the rubbles fell inside the boundary wall of Dharaharā."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/083ed396-3cc8-41ae-af0f-c4df103305ed> ;
