        hg:DestructionEvent ;
    rdfs:label "Damage by earthquake"@en ;
    dcterms:description "The uppermost tier was dislocated and the walls were cracked in the 2015 earthquakes. The dislocated tier was later removed and the finial was stored inside thesataḥsouth of the temple. Cracks were visible all around the temple including the corners of the Bhairava painting on the northern wall."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/313ebade-3b32-4491-845d-fe5520f8622c> ;
