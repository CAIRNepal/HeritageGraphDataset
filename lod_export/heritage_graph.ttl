<https://data.cairnepal.org/heritage/resource/event/fa3a74b1-ee19-4b08-bd78-4d9c72befbbe_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Offering of strut"@en ;
    dcterms:description "Aṭũḍāla(strut) was installed to support the weight of the lower roof of the temple. The nameMakutois carved upon it, which likely refers to the donor.मन्दिरको तल्लो छानाको भार थाम्न एउटा टुँडाल चढाइएको थियो । टुँडालमा मकुतो नाम कुँदिएको छ । उक्त नाम टुँडाल चढाउने दाताको हुनसक्छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/fa3a74b1-ee19-4b08-bd78-4d9c72befbbe> ;
    rdfs:comment "Aṭũḍāla(strut) was installed to support the weight of the lower roof of the temple. The nameMakutois carved upon it, which likely refers to the donor.मन्दिरको तल्लो छानाको भार थाम्न एउटा टुँडाल चढाइएको थियो । टुँडालमा मकुतो नाम कुँदिएको छ । उक्त नाम टुँडाल चढाउने दाताको हुनसक्छ ।"@en ;
