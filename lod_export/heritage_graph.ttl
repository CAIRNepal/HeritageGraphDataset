<https://data.cairnepal.org/heritage/resource/event/4d6391f7-6f08-487f-a5d3-3cc333593728_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the building"@en ;
    dcterms:description "Abhimāna Siṃha Basnyāta began the construction of this house three days after he received the ownership of the land in 1777 CE (B. ĀcāryaVS 2060, p. 95) and completed it in January 10, 1777 CE. The inscription recording this event was formerly installed at Nārāyaṇa Cuka (the courtyard behind the Palṭana Ghara) but no one knows its whereabout now (as of December 2021)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/4d6391f7-6f08-487f-a5d3-3cc333593728> ;
