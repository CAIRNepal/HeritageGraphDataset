<https://data.cairnepal.org/heritage/resource/event/0a006229-7e08-4cb2-9883-1527f615bbfb_1> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Obtainment of sāla timbers"@en ;
    dcterms:description "Timbers of thesāla(shorea robusta) variety were obtained from various places like Nālā, Panautī, Caukoṭa, Vābhudvã, and Yãlādvã for building the temple."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/0a006229-7e08-4cb2-9883-1527f615bbfb> ;
