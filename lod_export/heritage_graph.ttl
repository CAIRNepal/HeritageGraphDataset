<https://data.cairnepal.org/heritage/resource/event/3eed6ff1-e60f-4425-b7dc-052f8094f611_6> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Inauguration programme"@en ;
    dcterms:description "Following the completion of the reconstruction project, the Phalcā was officially inaugurated by the Mayor of Kirtipur. As part of this significant event, a mound of samaybaji was exhibited in front of the Phalcā. This exhibition marked a historic occasion, as it was the first time such an event had taken place in the history of the Phalcā."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/3eed6ff1-e60f-4425-b7dc-052f8094f611> ;
    rdfs:comment "Following the completion of the reconstruction project, the Phalcā was officially inaugurated by the Mayor of Kirtipur. As part of this significant event, a mound of samaybaji was exhibited in front of the Phalcā. This exhibition marked a historic occasion, as it was the first time such an event had taken place in the history of the Phalcā."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
