        hg:Production ;
    rdfs:label "Renovation"@en ;
    dcterms:description "A comprehensive restoration project, initiated in 2017 CE (VS 2074), restored the Bhaktapur Burjā and the other towers. The project received full financial and technical support from the Chinese government, with the Chinese Academy of Cultural Heritage (CACH) overseeing its execution. The restoration was completed in 2019 CE (VS 2076)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/eec66042-dacc-4c1f-94c0-0d90202581e4> ;
