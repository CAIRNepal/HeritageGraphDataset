    rdfs:label "Land endowment"@en ;
    dcterms:description "The state granted 150ropanīs of land in the name of Hanumantasiṃha Amātya for the expansion of the settlement in Kupondole and the maintenance of the Bagmati bridge."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/60d8283f-d7d3-4f40-a552-d9e2843a56b6> ;
