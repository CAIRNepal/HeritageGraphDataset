<https://data.cairnepal.org/heritage/resource/event/2548d9e2-ea78-11e9-b125-0242ac130002_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation, Donation and Offering of a roof"@en ;
    dcterms:description "Renovation of the Phalcā and offering of the roof by a group led by a person named Devisaṃṣa. The stone inscription (28 cm high, 16.5 cm wide) is attached to the centre of the back wall.The stone inscription of Dhaubaji phalcā is attached to the eastern wall. On the top of the inscription Lord Bhimsen's attribute, a club, is carved."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2548d9e2-ea78-11e9-b125-0242ac130002> ;
