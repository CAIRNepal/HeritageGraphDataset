        hg:DestructionEvent ;
    rdfs:label "Renovation of the monument"@en ;
    dcterms:description "According to Pruscha (1975, p. 258), the temple was renovated in 1940 CE (VS 1997), suggesting it may have been damaged in the 1934 earthquakes."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/64a2bcf3-96b8-4af7-9a2e-64be0fe4ca39> ;
