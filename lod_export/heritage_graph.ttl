<https://data.cairnepal.org/heritage/resource/event/ff7398f9-1bb2-4e4e-ba9b-c985565f74a7_3> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Rebuilding the Temple"@en ;
    dcterms:description "Kājīmāna Pradhāna rebuilt the temple between 1920 and 1921 CE. The reconstruction work was supervised by Bahādura Vajrācārya, who was also responsible for rebuilding theSātatale Darabāra'Seven Storey Palace' in Nuwakot after the earthquake in 1934 CE."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/ff7398f9-1bb2-4e4e-ba9b-c985565f74a7> ;
    rdfs:comment "Kājīmāna Pradhāna rebuilt the temple between 1920 and 1921 CE. The reconstruction work was supervised by Bahādura Vajrācārya, who was also responsible for rebuilding theSātatale Darabāra'Seven Storey Palace' in Nuwakot after the earthquake in 1934 CE."@en ;
