    rdfs:label "Establishment of Vijyādhari and Gatirāja statues"@en ;
    dcterms:description "Statues of Vijyādhari (Vidyādhari) and Gatirāja, devotees of Viṣṇu, were installed. The male and female figures above the spout are probably the statues that were installed on this occasion."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/3a28d662-e215-4ae6-952e-10972c20e974> ;
