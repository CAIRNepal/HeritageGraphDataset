<https://data.cairnepal.org/heritage/resource/event/229532ac-6835-483c-aa66-df0dea0b10cb_0> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "The temple was commissioned by a certain Harisiṃha, who endowed it with several plots of land to ensure the performance ofnitya(daily) andvārsika(annual) rituals. This information is recorded in an inscription preserved inside thegarbhagṛha(sanctum) of the temple. However, the section of the inscription bearing the date has been eroded. Pruscha (1975, p. 77) dated the inscription to 1637 CE (NS 757–758)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/229532ac-6835-483c-aa66-df0dea0b10cb> ;
    rdfs:comment "The temple was commissioned by a certain Harisiṃha, who endowed it with several plots of land to ensure the performance ofnitya(daily) andvārsika(annual) rituals. This information is recorded in an inscription preserved inside thegarbhagṛha(sanctum) of the temple. However, the section of the inscription bearing the date has been eroded. Pruscha (1975, p. 77) dated the inscription to 1637 CE (NS 757–758)."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
