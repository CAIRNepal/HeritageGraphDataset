        hg:DestructionEvent ;
    rdfs:label "Reconstruction"@en ;
    dcterms:description "As the Sataḥ was in a poor state of repair, it was dismantled and rebuilt from the ground up at the initiation of local residents. As modern bricks and cement were used during the reconstruction, the traditional architecture of the Sataḥ was lost."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/cc74e5d8-b70a-4612-8c34-ea4e721f1d4c> ;
