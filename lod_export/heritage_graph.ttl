<https://data.cairnepal.org/heritage/resource/event/62c22c28-9633-4f6d-a6e2-f942cf73af1c_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Installation of Tri-Bhīma Dhārā"@en ;
    dcterms:description "During the reign of King Tribhuvana, Prime Minister Bhīma Śamśera installed an iron water tap, known as Tri-Bhīma Dhārā (PPK1107-006), for the supply of drinking water to the public."@en ;
