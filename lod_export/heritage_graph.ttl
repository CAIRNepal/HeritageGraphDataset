<https://data.cairnepal.org/heritage/resource/event/7a255e97-0688-40e7-b5bd-70db941aa04f_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the sataḥ"@en ;
    dcterms:description "The Inventory published by the Department of Housing and Physical Infrastructure in VS 2036 mentions that thesataḥunderwent renovations in 1957/1958 CE (VS 2014)विसं २०३६ सालमा प्रकाशित एक इन्भेन्टोरी (VS 2039, p.p.166) मा  यस सतःको निर्माण दया शंकर भट्टले गरेको भनिएको छ र विसं २०१४, २०१८ र २०३२ सालमा जीर्णोद्धार गरिएको कुरा उल्लेख छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/7a255e97-0688-40e7-b5bd-70db941aa04f> ;
