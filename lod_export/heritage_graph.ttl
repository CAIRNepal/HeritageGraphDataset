<https://data.cairnepal.org/heritage/resource/event/8f96b8aa-88ff-43a7-94b2-91b81cd2d70d_0> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Land endowment"@en ;
    dcterms:description "A lālamohara issued by King Surendra records the donation of 4 ropanīs of land for the Sataḥ constructed by Kāśinātha. This document provides evidence that the Sataḥ was constructed before this specified date (K_0021_0016).विसं १९३१ (सन् १८७४-७५) मा राजा सुरेन्द्रबाट जारी एक लालमोहरमा काशीनाथले बनाएको सतःका खातिर ४ रोपनी जग्गादान सिफारिस भएको थियो । यस प्रसंगबाट यस मिति अगावै यहाँ सतःहरू बनिसकेको तथ्य खुलदछ (K_0021_0016) ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/8f96b8aa-88ff-43a7-94b2-91b81cd2d70d> ;
    rdfs:comment "A lālamohara issued by King Surendra records the donation of 4 ropanīs of land for the Sataḥ constructed by Kāśinātha. This document provides evidence that the Sataḥ was constructed before this specified date (K_0021_0016).विसं १९३१ (सन् १८७४-७५) मा राजा सुरेन्द्रबाट जारी एक लालमोहरमा काशीनाथले बनाएको सतःका खातिर ४ रोपनी जग्गादान सिफारिस भएको थियो । यस प्रसंगबाट यस मिति अगावै यहाँ सतःहरू बनिसकेको तथ्य खुलदछ (K_0021_0016) ।"@en ;
