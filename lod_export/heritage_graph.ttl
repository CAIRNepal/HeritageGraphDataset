<https://data.cairnepal.org/heritage/resource/event/2fe39e54-d189-4403-a7cb-0835b63e4387_1> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Reconstruction of the kvāḥpāḥchẽ"@en ;
    dcterms:description "Local residents reconstructed thekvāḥpāḥchẽin the early 1980s. A photo by Ganeshman Chitrakar, circa 1972/73 CE, shows the building in ruins. A photo by Hugh Downs, circa 1980-82, shows the reconstructedkvāḥpāḥchẽ.Many historic elements including the wall paintings weret lost in the reconstruction work."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2fe39e54-d189-4403-a7cb-0835b63e4387> ;
