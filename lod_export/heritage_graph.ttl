<https://data.cairnepal.org/heritage/resource/event/38b263ba-b32e-47e3-b72e-be30f4440f3e_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Primary School"@en ;
    dcterms:description "Sankhu Primary School was established in 1964 CE (VS 2021) in this Sataḥ. The school has run for more than 40 years. Because of insufficient space for growing classes, the school has meanwhile been shifted to Mahādevasthāna."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/38b263ba-b32e-47e3-b72e-be30f4440f3e> ;
