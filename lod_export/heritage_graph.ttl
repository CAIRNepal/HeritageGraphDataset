<https://data.cairnepal.org/heritage/resource/event/bf182f12-6d0a-4fd9-b0bc-228d66eb7f76_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Damage by earthquake"@en ;
    dcterms:description "The 2015 earthquakes badly damaged the temple. Half of its dome collapsed while the temple only barely managed to remain standing with cracks all around. About three months later, overnight rain on August 20, 2015, made the temple collapse on the morning of August 21st."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/bf182f12-6d0a-4fd9-b0bc-228d66eb7f76> ;
    rdfs:comment "The 2015 earthquakes badly damaged the temple. Half of its dome collapsed while the temple only barely managed to remain standing with cracks all around. About three months later, overnight rain on August 20, 2015, made the temple collapse on the morning of August 21st."@en ;
