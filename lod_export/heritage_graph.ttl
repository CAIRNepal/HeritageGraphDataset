<https://data.cairnepal.org/heritage/resource/event/12b7df25-b250-4592-8fad-2cc55ac79ff3_0> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Installation of the inscription by recording the construction of Temple and land endowment"@en ;
    dcterms:description "The stone inscription (see description above) erected by Udaya Bahādura Pā̃ḍe and his wife Lalitā Devī mentions the installation of the inscription by recording the construction of the Temple by his grandparents, parents and uncles on their private land and land endowment by them for the maintenance of the Temple. However, it does not mention the date of the Temple’s construction."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/12b7df25-b250-4592-8fad-2cc55ac79ff3> ;
