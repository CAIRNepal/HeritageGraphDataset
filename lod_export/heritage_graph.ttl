<https://data.cairnepal.org/heritage/resource/event/425bbdb8-54b5-474e-839a-7da85f116aa3_1> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Installation of a stone buffalo statue"@en ;
    dcterms:description "King Yoganarendra Malla installed a stone buffalo statue with a golden parasol at the temple after performing a night-long fire sacrifice with music and offerings."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/425bbdb8-54b5-474e-839a-7da85f116aa3> ;
    rdfs:comment "King Yoganarendra Malla installed a stone buffalo statue with a golden parasol at the temple after performing a night-long fire sacrifice with music and offerings."@en ;
