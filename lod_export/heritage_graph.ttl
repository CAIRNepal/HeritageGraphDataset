    rdfs:label "Construction of the palace"@en ;
    dcterms:description "King Siddinarasiṃha Malla built the palace including a hiti with a golden spout and many tantric statues. He also established the statues of Pañcamukhī Gaṇeśa and Narasiṃha."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/4c31625e-ea78-11e9-8bc4-0242ac130002> ;
