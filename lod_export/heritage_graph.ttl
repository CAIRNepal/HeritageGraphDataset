<https://data.cairnepal.org/heritage/resource/event/4ed2374c-e846-11e9-8bc4-0242ac130002_6> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Donation of a golden face to Akṣobhya"@en ;
    dcterms:description "Sūryarāja, Paru, Dharmmajoti, Bhairava and Hākurāja donated a golden face to Akṣobhya. It was agreed that if the golden face goes missing  the person responsible for performing the daily ritual worship must pay for its replacement. In this inscription, thebāhāḥis referred to as Jerabāhāra."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/4ed2374c-e846-11e9-8bc4-0242ac130002> ;
