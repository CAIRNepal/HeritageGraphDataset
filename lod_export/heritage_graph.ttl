<https://data.cairnepal.org/heritage/resource/event/f25241a7-dacd-46b6-8cf2-f1fcd554e95c_4> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation"@en ;
    dcterms:description "A comprehensive restoration project, initiated in 2017 CE (VS 2074), restored the Kirtipur Burjā and the other towers. The project received full financial and technical support from the Chinese government, with the Chinese Academy of Cultural Heritage (CACH) overseeing its execution. The restoration was completed in 2019 CE (VS 2076)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f25241a7-dacd-46b6-8cf2-f1fcd554e95c> ;
