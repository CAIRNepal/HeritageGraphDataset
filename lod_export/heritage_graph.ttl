<https://data.cairnepal.org/heritage/resource/event/afa386ca-8eea-11ea-bd59-0242ac130005_6> a crm:E5_Event,
        hg:RitualEvent ;
    rdfs:label "Buffalo bone manure factory closed"@en ;
    dcterms:description "A factory producing manure from buffalo bones was established to the east of the Hiti. After heavy rains, the water from the bones collected in the factory mixed with the water for the Hiti, and bloody water started to flow from the spouts. The administration closed the bone factory after locals protested."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/afa386ca-8eea-11ea-bd59-0242ac130005> ;
