        hg:DestructionEvent ;
    rdfs:label "Special worship after earthquake 2015"@en ;
    dcterms:description "A local organization named Asana Pāsā Pucaḥ organized a fire oblation to appease the planetary deities following the massive loss of lives and property in the 2015 earthquakes."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d30593b5-c63b-47d9-90a0-b101b2ebac77> ;
