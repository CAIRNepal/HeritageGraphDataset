<https://data.cairnepal.org/heritage/resource/event/98358087-f88c-480f-995e-f2d25eb4527b_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "According to C. Nepālī (VS 2020, p.26), Raṇabahādura Śāha built the Temple and also established abhairavīcakrain the month of Phālguna in 1797 CE (VS 1853). Similarly, Hasrat (1970, p.156) mentions the establishment date as the month of Māgha in 1797 CE (NS 917). Gutschow (2011, p. 891), on the other hand, believes it was built around 1794 CE by Raṇa Bahādura."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/98358087-f88c-480f-995e-f2d25eb4527b> ;
    rdfs:comment "According to C. Nepālī (VS 2020, p.26), Raṇabahādura Śāha built the Temple and also established abhairavīcakrain the month of Phālguna in 1797 CE (VS 1853). Similarly, Hasrat (1970, p.156) mentions the establishment date as the month of Māgha in 1797 CE (NS 917). Gutschow (2011, p. 891), on the other hand, believes it was built around 1794 CE by Raṇa Bahādura."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
