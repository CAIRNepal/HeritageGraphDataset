<https://data.cairnepal.org/heritage/resource/event/d0dd5bdf-90e7-4217-a90c-83504c9ea90b_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Installation of roof"@en ;
    dcterms:description "With the aim of shielding the statue from unceasing sun and rain, devotees joined forces to install a tin roof over the revered figure. They diligently replaced the small parasol that had adorned it before, ensuring that the elements would no longer impinge upon its sacred presence."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d0dd5bdf-90e7-4217-a90c-83504c9ea90b> ;
