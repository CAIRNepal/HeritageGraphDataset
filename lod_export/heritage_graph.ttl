<https://data.cairnepal.org/heritage/resource/event/c4f5a233-92eb-49e5-9c09-8bb123453f98_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Bell installation"@en ;
    dcterms:description "The bell, positioned in front of thesataḥ, bears a votive inscription documenting its dedication to Goddess Gaurī by Mukhyānī Viṣṇubhakta Kumārī, the senior wife of Colonel Dalabhajana Thāpā, in 1888 CE (VS 1944). This clearly suggests that thesataḥwas constructed before this date."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/c4f5a233-92eb-49e5-9c09-8bb123453f98> ;
