<https://data.cairnepal.org/heritage/resource/event/c5095309-3c27-4122-a7a1-81532551e98c_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the Fountain"@en ;
    dcterms:description "The stone slab inscription above the spout records that the Fountain was built during the reign of King Mahendra (who reigned from 1955 CE to his death in 1972 CE) and named ‘Fivefold Venerable Mahendra Dhārā”.The inscription reads:Śrī(written on top margin)Line1:śrī 5 mahendra dhārāḥ(!)Line2:a. ma. bhai. bināyakaLine3:grāma pañcāyataLine4:pra. paṃ. rana bahādura kaḍāyataLine5:kṣetrīLine6:samba(!)ta 2020 sāla bhādraLine7:2 gate roja 1 māḥ(!) ||"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/c5095309-3c27-4122-a7a1-81532551e98c> ;
    rdfs:comment "The stone slab inscription above the spout records that the Fountain was built during the reign of King Mahendra (who reigned from 1955 CE to his death in 1972 CE) and named ‘Fivefold Venerable Mahendra Dhārā”.The inscription reads:Śrī(written on top margin)Line1:śrī 5 mahendra dhārāḥ(!)Line2:a. ma. bhai. bināyakaLine3:grāma pañcāyataLine4:pra. paṃ. rana bahādura kaḍāyataLine5:kṣetrīLine6:samba(!)ta 2020 sāla bhādraLine7:2 gate roja 1 māḥ(!) ||"@en ;
