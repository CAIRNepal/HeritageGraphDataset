<https://data.cairnepal.org/heritage/resource/event/229dc17a-452d-4986-bf4a-4e56326009f8_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial Construction"@en ;
    dcterms:description "यस मन्दिरको निर्माणबारे केही तथ्य प्रकाश पार्न सकिने अभिलेख संगैको यन्त्र वत्सला मन्दिरभित्र प्राप्त छ । उक्त अभिलेखमा नेसं ८१६ (सन् १६९६) मा राजा जितामित्र मल्लले सो मन्दिरमा वत्सला देवीको स्थापना गर्नुका साथै यस मन्दिरमा सिद्धिलक्ष्मी स्थापना गरेको उल्लेख छ (B. Pauḍela VS 2022, p.50)। सिद्धिलक्ष्मीको यस मन्दिर बनाउने कार्यको थलानी नेसं ८१३ (सन् १६९३) बाटै सुरु भैसकेको तथ्य भक्तपुरस्थित वासुकी खोला किनारमा भएको ढुङ्गामा कुँदिएको अभिलेखबाट खुल्दछ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/229dc17a-452d-4986-bf4a-4e56326009f8> ;
    rdfs:comment "यस मन्दिरको निर्माणबारे केही तथ्य प्रकाश पार्न सकिने अभिलेख संगैको यन्त्र वत्सला मन्दिरभित्र प्राप्त छ । उक्त अभिलेखमा नेसं ८१६ (सन् १६९६) मा राजा जितामित्र मल्लले सो मन्दिरमा वत्सला देवीको स्थापना गर्नुका साथै यस मन्दिरमा सिद्धिलक्ष्मी स्थापना गरेको उल्लेख छ (B. Pauḍela VS 2022, p.50)। सिद्धिलक्ष्मीको यस मन्दिर बनाउने कार्यको थलानी नेसं ८१३ (सन् १६९३) बाटै सुरु भैसकेको तथ्य भक्तपुरस्थित वासुकी खोला किनारमा भएको ढुङ्गामा कुँदिएको अभिलेखबाट खुल्दछ ।"@en ;
