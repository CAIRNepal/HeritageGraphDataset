<https://data.cairnepal.org/heritage/resource/event/eb8b64bc-f627-4105-ad28-2652ef389657_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the hiti"@en ;
    dcterms:description "Three individuals Budhimānsi (Buddhimānasiṃha) Rajaka, Rāmadāsa Rajaka, and Herā Rajaka together with their families, renovated Hiku Hiti. After the renovation, they performed worship and the installation ritual (pratiṣṭhākarma) of the hiti. Responsibility for the care of the hiti was entrusted to the descendants of Budhimānsi, Rāmadāsa, and Herā Rajaka."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/eb8b64bc-f627-4105-ad28-2652ef389657> ;
    rdfs:comment "Three individuals Budhimānsi (Buddhimānasiṃha) Rajaka, Rāmadāsa Rajaka, and Herā Rajaka together with their families, renovated Hiku Hiti. After the renovation, they performed worship and the installation ritual (pratiṣṭhākarma) of the hiti. Responsibility for the care of the hiti was entrusted to the descendants of Budhimānsi, Rāmadāsa, and Herā Rajaka."@en ;
