        hg:Production ;
    rdfs:label "Rebuilding of the dyaḥchẽ"@en ;
    dcterms:description "Thedyaḥchẽwas rebuilt by a Maharjana family. This renovation task was done in the name of late Suśīlā Maharjan."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/8ef7a2bb-be68-438f-9902-2914c6ebc9f1> ;
