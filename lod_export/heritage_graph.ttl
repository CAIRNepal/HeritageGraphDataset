    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 1 ;
    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/77b88f79-3bc0-4373-8673-e60310fa5c97> .

<https://data.cairnepal.org/heritage/resource/event/77b88f79-3bc0-4373-8673-e60310fa5c97_2> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Renovation of the monument"@en ;
    dcterms:description "An inscription of 1763 CE (NS 883) installed at the Brahmāyaṇī Pīṭha (SKH0123) states that the ‘maṇḍapa’ of the Sālkhā Ṭola was renovated and a land endowment was made to manifest and improve the status of Piunārāyaṇa and his family from Kathmandu. As this is the onlymaṇḍapain Sālkhā Ṭola, it is clear that the renovation refers to it. The Inscription was probably shifted to the nearby Brahmāyaṇī Pīṭha later."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/77b88f79-3bc0-4373-8673-e60310fa5c97> ;
    rdfs:comment "An inscription of 1763 CE (NS 883) installed at the Brahmāyaṇī Pīṭha (SKH0123) states that the ‘maṇḍapa’ of the Sālkhā Ṭola was renovated and a land endowment was made to manifest and improve the status of Piunārāyaṇa and his family from Kathmandu. As this is the onlymaṇḍapain Sālkhā Ṭola, it is clear that the renovation refers to it. The Inscription was probably shifted to the nearby Brahmāyaṇī Pīṭha later."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
