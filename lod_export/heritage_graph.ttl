<https://data.cairnepal.org/heritage/resource/event/3eed6ff1-e60f-4425-b7dc-052f8094f611_5> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Reconstruction after 2015"@en ;
    dcterms:description "The Phalcā was already in poor condition before the 2015 earthquakes. The tremors further deteriorated its condition. The Department of Archaeology enabled reconstruction in 2021 CE."@en ;
