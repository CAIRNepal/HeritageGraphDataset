<https://data.cairnepal.org/heritage/resource/event/48fbbcba-9da1-11ea-82af-0242ac130005_3> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Historical event NS 907"@en ;
    dcterms:description "Matsyendrasiṃha Bhāro of Aki Bāhāḥ Patan donated acapāḥto please Kvaynā Gaṇeśa and installed idols of Umāmaheśvara and Lakṣmīnārāyaṇa in it. He also bestowed fourropanīsand onejabafield to establish aguṭhī. Theguṭhīwas also responsible for repairing minor damages."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/48fbbcba-9da1-11ea-82af-0242ac130005> ;
