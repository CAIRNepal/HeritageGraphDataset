<https://data.cairnepal.org/heritage/resource/event/f142c371-6fa0-4599-ad3f-8bd47469406e_4> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Rebuilt"@en ;
    dcterms:description "विसं २०७२ (सन् २०१५) को भूकम्पले ठूलो क्षति पुगेको यस मन्दिरको भित्ताहरू सबै चर्केको र छानो पनि भत्कने खतरा थियो त्यसैले विसं २०७४ (सन् २०१७) देखि पुरातत्व विभागले मन्दिरको पुनर्णिर्माण कार्य गर्न सुरु गरेको थियो । हाल (अप्रिल, २०२३) पुनर्निर्माणको कार्य अन्तिम चरणमा पुगिसकेको छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f142c371-6fa0-4599-ad3f-8bd47469406e> ;
    rdfs:comment "विसं २०७२ (सन् २०१५) को भूकम्पले ठूलो क्षति पुगेको यस मन्दिरको भित्ताहरू सबै चर्केको र छानो पनि भत्कने खतरा थियो त्यसैले विसं २०७४ (सन् २०१७) देखि पुरातत्व विभागले मन्दिरको पुनर्णिर्माण कार्य गर्न सुरु गरेको थियो । हाल (अप्रिल, २०२३) पुनर्निर्माणको कार्य अन्तिम चरणमा पुगिसकेको छ ।"@en ;
