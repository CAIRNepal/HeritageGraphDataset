<https://data.cairnepal.org/heritage/resource/event/5d9e8143-340e-4846-a7a9-4f95bfc10421_8> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the hiti"@en ;
    dcterms:description "In memory of his deceased parents Khilākumārī Thāpā and Hirāsiṃha Thāpā, Dilabahādura Thāpā renovated the stone water spout (hiti) southeast of the temple. Originally, there was only one spout. Two additional spouts were added during the renovation while the original one was replaced with a new one. The original spout lies unattended next to the water spouts."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5d9e8143-340e-4846-a7a9-4f95bfc10421> ;
