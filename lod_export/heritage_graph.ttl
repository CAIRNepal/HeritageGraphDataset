        hg:DestructionEvent ;
    rdfs:label "Repair of the temple"@en ;
    dcterms:description "After the temple sustained some damage in the 2015 CE (VS 2072) earthquake, Balrām K.C. of Kopaṇḍola undertook its restoration in memory of his late father Kālugaṇḍe K.C., his late mother Kāñchī K.C., and his late wife Bhagavatī K.C."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/e277eff9-5f7a-405c-908b-e3d13cda743e> ;
