<https://data.cairnepal.org/heritage/resource/event/e77be04f-be3a-4445-b751-0cb7995daf6a_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of a temple of Lokeśvara (this event is not related to the Dyaḥchẽ)"@en ;
    dcterms:description "The Lokeśvara statue with an inscription on its bottom (see above, object KAT1170-002) has nothing to do with the Kaṅgaḥ Ajimā Dyaḥchẽ. The inscription mentions the renovation of a Lokeśvara temple (likely the one where this statue was originally located) and the gift of a golden crest jewel. It is unknown where and when this statue was relocated to its current location."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/e77be04f-be3a-4445-b751-0cb7995daf6a> ;
