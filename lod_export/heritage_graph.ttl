<https://data.cairnepal.org/heritage/resource/event/5d9c1eae-e1c7-43bc-905a-a0816724b854_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of Kumbheśvara Temple"@en ;
    dcterms:description "पहिले कुम्भेश्वर महादेवको मन्दिर केवल छाप्रो मात्र थियो । ललितपुर निवासी जयभीम नाम गरेका महाजनकी श्रीमती अनन्तलक्ष्मी बिरामी भएपछि जयभीमले श्रीमती निको भएमा कुम्भेश्वरको सुन्दर मन्दिर बनाइदिनेछु भनी भाकल गरेका थिए । तर उनकी श्रीमतीको निधन भयो । तैपनि जयभीमले दिवंगत श्रीमतीको स्मृतिमा नेसं ५१२ (सन् १३९२) मा कुम्भेश्वर मन्दिरको निर्माण गरिदिएका थिए । मन्दिर निर्माण कार्य सम्पन्न भएको उपलक्ष्यमा जयभीमकी कान्छी श्रीमतीले सुवर्ण कोश चढाई लक्ष्याहुति यज्ञ गरी मन्दिरमा सुनको गजूर चढाइकी थिइन् । त्यस समयमा नेपालमण्डलमा जयस्थिति मल्लको शासन चलिरहेको थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5d9c1eae-e1c7-43bc-905a-a0816724b854> ;
    rdfs:comment "पहिले कुम्भेश्वर महादेवको मन्दिर केवल छाप्रो मात्र थियो । ललितपुर निवासी जयभीम नाम गरेका महाजनकी श्रीमती अनन्तलक्ष्मी बिरामी भएपछि जयभीमले श्रीमती निको भएमा कुम्भेश्वरको सुन्दर मन्दिर बनाइदिनेछु भनी भाकल गरेका थिए । तर उनकी श्रीमतीको निधन भयो । तैपनि जयभीमले दिवंगत श्रीमतीको स्मृतिमा नेसं ५१२ (सन् १३९२) मा कुम्भेश्वर मन्दिरको निर्माण गरिदिएका थिए । मन्दिर निर्माण कार्य सम्पन्न भएको उपलक्ष्यमा जयभीमकी कान्छी श्रीमतीले सुवर्ण कोश चढाई लक्ष्याहुति यज्ञ गरी मन्दिरमा सुनको गजूर चढाइकी थिइन् । त्यस समयमा नेपालमण्डलमा जयस्थिति मल्लको शासन चलिरहेको थियो ।"@en ;
