<https://data.cairnepal.org/heritage/resource/event/90ae9fac-535a-4b18-9034-d97dda03d621_3> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Installation of stone inscription"@en ;
    dcterms:description "Dhīra Śamśera had a large inscription installed, incorporating the contents of previous inscriptions that were separately installed for each of the temples established next to Dhīrabhakteśvara in honor of his wives. This combined inscription instructs various rituals to be performed at each of the temples on designated days and lists land parcels donated to the trust."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/90ae9fac-535a-4b18-9034-d97dda03d621> ;
    rdfs:comment "Dhīra Śamśera had a large inscription installed, incorporating the contents of previous inscriptions that were separately installed for each of the temples established next to Dhīrabhakteśvara in honor of his wives. This combined inscription instructs various rituals to be performed at each of the temples on designated days and lists land parcels donated to the trust."@en ;
