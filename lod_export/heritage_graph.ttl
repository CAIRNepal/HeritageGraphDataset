<https://data.cairnepal.org/heritage/resource/event/5cb98dcd-6658-4b9c-8990-8c2299397aca_9> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of a Pond"@en ;
    dcterms:description "A pond called Palesvā̃ Pukhū was constructed behind the temple on the eastern side. It is believed that Bālakumārī used to take bath in this pond (Śreṣṭha S. 2068, 24). However, this pond dried long ago and cannot be identified."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5cb98dcd-6658-4b9c-8990-8c2299397aca> ;
