<https://data.cairnepal.org/heritage/resource/event/48dc7bc9-effe-43fd-ab20-228d51298ccb_9> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the phalcā"@en ;
    dcterms:description "Apart from constructing the present Temple structure, the Maitrī Parivāra Club also renovated the Bhagavatī Dhvākhā Phalcā (KAT0151) with the financial assistance from the Pacific Asia Travel Association (PATA). Marble tiles were also laid in the courtyard on the occasion."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/48dc7bc9-effe-43fd-ab20-228d51298ccb> ;
