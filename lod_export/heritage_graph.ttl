<https://data.cairnepal.org/heritage/resource/event/6f0c05ad-bc03-4ff3-9fa9-3ce6adf31e9b_1> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Endowment of land parcels"@en ;
    dcterms:description "Dīrghalakṣmī Kũvara endowed over 360ropanīs of land parcels and documented the religious trust’s income and responsibilities in an 1881CE inscription. Being from a prominent family, she received 185ropanīs of land from the king for the temples. An inscription installed after the construction highlights her noble birth."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/6f0c05ad-bc03-4ff3-9fa9-3ce6adf31e9b> ;
