<https://data.cairnepal.org/heritage/resource/event/d7e3c28c-e1ab-430b-9b2d-9b69475905a9_2> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Renovation of the Phalcā"@en ;
    dcterms:description "The inscription transferred to the Phalcā dates back to 1889 CE (1009 NS) and records the restoration of the Phalcā as facilitated by the son of Amitanārā (Amita Nārāyaṇa) and Mayajumunī. The inscription also records that tmembers of the clan that is responsible for the restoration of the Phalcā are exempt from rent obligations, while those living within the Phalcā are requested to distribute ritual food (samaybaji) and to place lights in the Phalcā during the full moon of Bhādra."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d7e3c28c-e1ab-430b-9b2d-9b69475905a9> ;
    rdfs:comment "The inscription transferred to the Phalcā dates back to 1889 CE (1009 NS) and records the restoration of the Phalcā as facilitated by the son of Amitanārā (Amita Nārāyaṇa) and Mayajumunī. The inscription also records that tmembers of the clan that is responsible for the restoration of the Phalcā are exempt from rent obligations, while those living within the Phalcā are requested to distribute ritual food (samaybaji) and to place lights in the Phalcā during the full moon of Bhādra."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
