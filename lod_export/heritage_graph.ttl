<https://data.cairnepal.org/heritage/resource/event/ec08dc4c-646f-45bd-b152-4781e312bd08_14> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the monument"@en ;
    dcterms:description "During the reign of King Virendra, a restoration project was initiated for the temple, necessitating the disassembly and reconstruction of the upper tier. This endeavor received financial support not only from the local community but also from the Guṭhī Saṃsthāna. The record pertaining to this renovation is inscribed on the western façade of the Naradevī Sataḥ (KAT1111)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/ec08dc4c-646f-45bd-b152-4781e312bd08> ;
