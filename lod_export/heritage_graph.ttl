<https://data.cairnepal.org/heritage/resource/event/75171568-d049-4c63-9fce-ddf40dc4e157_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Rebuilt of the monument"@en ;
    dcterms:description "The Municipality formed a users’ committee, a Kārya Saṃcālana Samiti, to oversee the reconstruction work in 2016 CE (VS 2073), and released Rs 1, 28, 62,213 (Bhaktapur Municipality). The work was completed in 2020 CE (VS 2077)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/75171568-d049-4c63-9fce-ddf40dc4e157> ;
