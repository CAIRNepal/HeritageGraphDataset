    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/63ee2cfd-8c43-457b-970c-a837cc8f7f11> .

<https://data.cairnepal.org/heritage/resource/event/643123c2-89d5-4ff5-a1b4-5d9b943d3a7b_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Installation of a Lakṣmīnārāyaṇa statue"@en ;
    dcterms:description "An inscription from the time of Yoganarendra Malla records that Keśavarāja Bhāro installed a Lakṣmīnārāyaṇa statue in the month of Āṣāḍha in memory of his deceased wife Śakuntarāmayī.फल्चामा प्राप्त  योगनरेेन्द्र मल्लको शसनकालको अभिलेखमा नेसं ८२० (सन् १७००) मा केशवराज भारो र उनकी दीवंगत पत्नी शकुन्तरामयीको नाममा आषाढ महिनामा लक्ष्मीनारायणको मूर्ति स्थापना गरिएको थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/643123c2-89d5-4ff5-a1b4-5d9b943d3a7b> ;
    rdfs:comment "An inscription from the time of Yoganarendra Malla records that Keśavarāja Bhāro installed a Lakṣmīnārāyaṇa statue in the month of Āṣāḍha in memory of his deceased wife Śakuntarāmayī.फल्चामा प्राप्त  योगनरेेन्द्र मल्लको शसनकालको अभिलेखमा नेसं ८२० (सन् १७००) मा केशवराज भारो र उनकी दीवंगत पत्नी शकुन्तरामयीको नाममा आषाढ महिनामा लक्ष्मीनारायणको मूर्ति स्थापना गरिएको थियो ।"@en ;
