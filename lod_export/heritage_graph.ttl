        crm:E5_Event,
        hg:Production ;
    rdfs:label "Inauguration of bridge"@en ;
    dcterms:description "The bridge was inaugurated by Queen Lalitatripurasundarī after 15 months of the laying of the foundation stone. A stone inscription marks this achievement, noting the bridge's 1253-cubit length and the involvement of a government officer named Lakṣmīnārāyaṇa."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/91ae947b-5f53-49ec-82f2-a6e9445ead42> ;
