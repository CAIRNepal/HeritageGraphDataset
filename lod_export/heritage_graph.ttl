<https://data.cairnepal.org/heritage/resource/event/f142c371-6fa0-4599-ad3f-8bd47469406e_2> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Renovation"@en ;
    dcterms:description "The temple was damaged in the great earthquake of 1990 VS (1934 CE), and it was renovated two years later, in 1992 VS (1935 CE). However, Pruscha (1975, p.96) mentions that the renovation of the temple took place in 1936."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f142c371-6fa0-4599-ad3f-8bd47469406e> ;
