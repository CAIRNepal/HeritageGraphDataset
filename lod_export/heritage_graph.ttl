<https://data.cairnepal.org/heritage/resource/event/f2fd559b-9b9c-4c38-a353-9ee22dad0272_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the durbar"@en ;
    dcterms:description "After capturing Nuwakot and consolidating his financial position, King Pṛthvīnārāyaṇa Śāha constructed the Sātatale Durbar. In the inscription installed after its completion, he proudly proclaimed that he had broken the arrogance of the kings of Nepal (the Kathmandu Valley), captured King Trivikrama Sena of Tanahũ, and slain the Muslim customs officials stationed at the checkpoint upon his return from Kāśī.पृथ्वीनारायण शाहले नुवाकोट कब्जा गरेर आफ्नो आर्थिक अवस्था सुदृढ बनाइसकेपछि साततले दरबार निर्माण गरेका थिए । दरबार बनाइसकेपछि राखिएको अभिलेखमा उनले नेपाल (काठमाडौं उपत्यका) का राजाहरूको घमण्ड तोडेको, तनहुँका राजा त्रिविक्रम सेनलाई बन्दी बनाएको र काशीबाट फर्केर आउँदा भन्सारमा बस्ने मुसलमान अधिकारीहरूलाई मारेको भनी गर्व गरेका छन् ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f2fd559b-9b9c-4c38-a353-9ee22dad0272> ;
    rdfs:comment "After capturing Nuwakot and consolidating his financial position, King Pṛthvīnārāyaṇa Śāha constructed the Sātatale Durbar. In the inscription installed after its completion, he proudly proclaimed that he had broken the arrogance of the kings of Nepal (the Kathmandu Valley), captured King Trivikrama Sena of Tanahũ, and slain the Muslim customs officials stationed at the checkpoint upon his return from Kāśī.पृथ्वीनारायण शाहले नुवाकोट कब्जा गरेर आफ्नो आर्थिक अवस्था सुदृढ बनाइसकेपछि साततले दरबार निर्माण गरेका थिए । दरबार बनाइसकेपछि राखिएको अभिलेखमा उनले नेपाल (काठमाडौं उपत्यका) का राजाहरूको घमण्ड तोडेको, तनहुँका राजा त्रिविक्रम सेनलाई बन्दी बनाएको र काशीबाट फर्केर आउँदा भन्सारमा बस्ने मुसलमान अधिकारीहरूलाई मारेको भनी गर्व गरेका छन् ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
