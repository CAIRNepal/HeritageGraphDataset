<https://data.cairnepal.org/heritage/resource/event/72676e36-5aa7-47f1-b79e-75b63d2cb09a_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "The Gorakhpur queen, one of Jaṅga Bahādura's many queens, facilitated the construction of the Sataḥ and the Gopāla Mandir (KAT2810) six years after her husband's death. She also donated a vast tract of land to establish a religious trust for the maintenance and timely renovations of both the temple and Sataḥ."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/72676e36-5aa7-47f1-b79e-75b63d2cb09a> ;
