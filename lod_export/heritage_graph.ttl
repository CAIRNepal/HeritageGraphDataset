<https://data.cairnepal.org/heritage/resource/event/37637b5c-2c47-4579-bfaf-4e6c503a0fca_2> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Restoration of rest souses (sataḥ)"@en ;
    dcterms:description "By December 2022 CE, a significant portion of the rest houses, approximately 80%, had been disassembled due to the effects of the earthquakes. The Department of Archaeology has undertaken plans for the eventual restoration of these structures."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/37637b5c-2c47-4579-bfaf-4e6c503a0fca> ;
