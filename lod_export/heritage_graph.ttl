<https://data.cairnepal.org/heritage/resource/event/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6_0> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "1934 CE earthquakes damage"@en ;
    dcterms:description "The temple suffered major damage during the 1934 CE earthquakes. Photos taken afterward reveal significant structural harm, yet the temple remained standing and did not collapse."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6> ;
    rdfs:comment "The temple suffered major damage during the 1934 CE earthquakes. Photos taken afterward reveal significant structural harm, yet the temple remained standing and did not collapse."@en ;
