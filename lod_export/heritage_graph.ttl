<https://data.cairnepal.org/heritage/resource/event/03ab0902-61c8-4458-8eee-f23e345d9372_0> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Collapsed during 1934 earthquake"@en ;
    dcterms:description "This Phalcā completely collapsed during the 1934 earthquake. Its original function was abandoned and the remnants of the building were used as a platform before it was finally rebuilt in 2012."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/03ab0902-61c8-4458-8eee-f23e345d9372> ;
