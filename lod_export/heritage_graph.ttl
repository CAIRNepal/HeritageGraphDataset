<https://data.cairnepal.org/heritage/resource/event/e4fe41d3-ce80-44ea-a77d-df8e00c5ea57_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Reconstruction of the Phalcā"@en ;
    dcterms:description "In VS 2057 (2000 CE) the derelict Phalcā was reconstructed with the support of the Lalitpur Municipality (they donated 153.000 rupees) and support from the local community. Two more bays and iron railings were also added during the reconstruction."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/e4fe41d3-ce80-44ea-a77d-df8e00c5ea57> ;
