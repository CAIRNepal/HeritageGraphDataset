<https://data.cairnepal.org/heritage/resource/event/0afcf58b-7bbc-496a-aeb8-9692f3fa8ce5_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Reconstruction"@en ;
    dcterms:description "The temple underwent a rebuilding process led by the High-Powered Committee for Integrated Development of the Bagmati Civilization, an entity operating under the Ministry of Urban Development. Financial support for the project was extended by the Asian Development Bank. The comprehensive reconstruction effort was officially concluded in October 2022 CE."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/0afcf58b-7bbc-496a-aeb8-9692f3fa8ce5> ;
