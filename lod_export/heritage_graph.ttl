<https://data.cairnepal.org/heritage/resource/event/3440946e-e936-11e9-b125-0242ac130002_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction of the temple"@en ;
    dcterms:description "Purandara Siṃha Deva, a Mahāpātra of Lalitpur, built this temple in memory of his father Viṣṇu Siṃha. The inscription states that Purandara Siṃha Deva declared his son Purushottama as the prince and was preparing to make him king."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/3440946e-e936-11e9-b125-0242ac130002> ;
    rdfs:comment "Purandara Siṃha Deva, a Mahāpātra of Lalitpur, built this temple in memory of his father Viṣṇu Siṃha. The inscription states that Purandara Siṃha Deva declared his son Purushottama as the prince and was preparing to make him king."@en ;
