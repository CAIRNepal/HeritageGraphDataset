<https://data.cairnepal.org/heritage/resource/event/25c65422-6b9b-11ea-8083-0242ac130006_0> a crm:E5_Event,
        hg:Consecration ;
    rdfs:label "Consecration of a new statue of Khaḍgayoginī"@en ;
    dcterms:description "After the original statue of Khaḍgayoginī was stolen in 1979 CE, a newly built deity's statue was consecrated in 1980 CE. The consecration ritual performed by 12 Vajrācārya tantric priests lasted for 14 days (from the 3rd to 27th of Āṣāḍha in VS 2037). The closing ceremony of this ritual took place on the 28th of Āṣāḍha."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/25c65422-6b9b-11ea-8083-0242ac130006> ;
    rdfs:comment "After the original statue of Khaḍgayoginī was stolen in 1979 CE, a newly built deity's statue was consecrated in 1980 CE. The consecration ritual performed by 12 Vajrācārya tantric priests lasted for 14 days (from the 3rd to 27th of Āṣāḍha in VS 2037). The closing ceremony of this ritual took place on the 28th of Āṣāḍha."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
