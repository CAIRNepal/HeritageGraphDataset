<https://data.cairnepal.org/heritage/resource/event/788cd320-e6a8-11e9-8bc4-0242ac130002_4> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of staircase"@en ;
    dcterms:description "A staircase was installed to connect the ground floor to the first floor (second storey). The staircase was constructed by Takṣakāra Mela and its donors were Laṇhasiju and Viśeśvaju from Haḥkha, as well as Halisaṃṣara (Hariśaṃkara) from Tulāchẽ."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/788cd320-e6a8-11e9-8bc4-0242ac130002> ;
