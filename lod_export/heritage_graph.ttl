<https://data.cairnepal.org/heritage/resource/event/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6_3> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Restoration"@en ;
    dcterms:description "Following the damage caused by the 2015 CE earthquakes, the US Ambassadors Fund for Cultural Preservation once again provided the financial support for the renovation. Collaboratively, the Kathmandu Valley Preservation Trust (KVPT) and the Department of Archaeology carried out the restoration."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/05ed8b92-7591-4f8d-8345-cf59ec1fc4c6> ;
