<https://data.cairnepal.org/heritage/resource/event/7e0a5b78-7360-46c6-a8e8-2422ff40011d_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Reconstruction of the monument"@en ;
    dcterms:description "विसं २०७२ को भूकम्प पश्चात् शहरी विकास मन्त्रलाय अन्तर्गत रहेको अधिकार सम्पन्न वागमती सभ्यता एकीकृत विकास समितिद्वारा एशियाली विकास बैंकको ऋण सहयोगमा यो धर्मशालाको पुनर्निमाण कार्यलाई पूर्णता दिइएको थियो । विसं २०७९ साल कार्तिक ६ गते (October 23rd, 2022) का दिन सतःको निर्माणकार्य सम्पन्न भएको थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/7e0a5b78-7360-46c6-a8e8-2422ff40011d> ;
    rdfs:comment "विसं २०७२ को भूकम्प पश्चात् शहरी विकास मन्त्रलाय अन्तर्गत रहेको अधिकार सम्पन्न वागमती सभ्यता एकीकृत विकास समितिद्वारा एशियाली विकास बैंकको ऋण सहयोगमा यो धर्मशालाको पुनर्निमाण कार्यलाई पूर्णता दिइएको थियो । विसं २०७९ साल कार्तिक ६ गते (October 23rd, 2022) का दिन सतःको निर्माणकार्य सम्पन्न भएको थियो ।"@en ;
