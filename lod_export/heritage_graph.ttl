<https://data.cairnepal.org/heritage/resource/event/04003b4d-8742-43dc-87f0-c6463c7a7474_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the caitya"@en ;
    dcterms:description "राजा सुरेन्द्र विक्रम शाहको राज्यकालमा खोकनाको कोथुपुषुली निवासी काश्यप गोत्रका भिख्वाल र उनकी श्रीमती बिसलक्ष्मिले परिवारका सदस्यहरूसँग मिलेर पहिले नै निर्माण गरिएको चैत्यको जीर्णोद्धार गरेका थिए । प्रत्येक वर्ष आश्विन शुक्ल ४ को दिनमा वर्षवर्द्धनपूजा गर्नुपर्ने व्यवस्था गरिएको थियो । त्यसको लागि ३ जव खेत गुठी राखिएको थियो । ललितपुरको चक्र महाविहारका जीवराज वज्राचार्यले चैत्य जीर्णोद्धार गर्दा पूजाको विधिविधान गर्ने पुरोहितको काम गरेका थिए ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/04003b4d-8742-43dc-87f0-c6463c7a7474> ;
    rdfs:comment "राजा सुरेन्द्र विक्रम शाहको राज्यकालमा खोकनाको कोथुपुषुली निवासी काश्यप गोत्रका भिख्वाल र उनकी श्रीमती बिसलक्ष्मिले परिवारका सदस्यहरूसँग मिलेर पहिले नै निर्माण गरिएको चैत्यको जीर्णोद्धार गरेका थिए । प्रत्येक वर्ष आश्विन शुक्ल ४ को दिनमा वर्षवर्द्धनपूजा गर्नुपर्ने व्यवस्था गरिएको थियो । त्यसको लागि ३ जव खेत गुठी राखिएको थियो । ललितपुरको चक्र महाविहारका जीवराज वज्राचार्यले चैत्य जीर्णोद्धार गर्दा पूजाको विधिविधान गर्ने पुरोहितको काम गरेका थिए ।"@en ;
