    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/1f0b12da-04ba-484b-bc1f-fe84fdcd3c6b> .

<https://data.cairnepal.org/heritage/resource/event/1f0b12da-04ba-484b-bc1f-fe84fdcd3c6b_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation and installation of statues"@en ;
    dcterms:description "Over time, thesataḥcollapsed, thehitidried up, and the pond nearly vanished. Changunarayan Municipality restored the structures, adding a Śiva statue, along with his vehicular mount Nandī, and a Hanumān statue donated by Kedārabahādura Thāpā’s family."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/1f0b12da-04ba-484b-bc1f-fe84fdcd3c6b> ;
    rdfs:comment "Over time, thesataḥcollapsed, thehitidried up, and the pond nearly vanished. Changunarayan Municipality restored the structures, adding a Śiva statue, along with his vehicular mount Nandī, and a Hanumān statue donated by Kedārabahādura Thāpā’s family."@en ;
