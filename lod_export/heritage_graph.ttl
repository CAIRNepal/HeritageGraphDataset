<https://data.cairnepal.org/heritage/resource/event/673afbfc-e6f2-11e9-8bc4-0242ac130002_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Restoration"@en ;
    dcterms:description "Lalitpur Municipality donated 12,000 Nepalese Rupees and ca. 25,000 Nepalese Rupees were collected from local donors for the restoration of thesataḥ."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/673afbfc-e6f2-11e9-8bc4-0242ac130002> ;
    rdfs:comment "Lalitpur Municipality donated 12,000 Nepalese Rupees and ca. 25,000 Nepalese Rupees were collected from local donors for the restoration of thesataḥ."@en ;
