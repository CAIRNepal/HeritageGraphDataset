    rdfs:label "Construction of the present temple structure"@en ;
    dcterms:description "As mentioned above in the description, this place was a small shrine under an open sky before the present temple structure was constructed by Ratnamāna Śreṣṭha and Īndramāna Śreṣṭha in 1955 CE."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/0826415c-dd5f-4666-aa9e-7ecbb32bfd60> ;
