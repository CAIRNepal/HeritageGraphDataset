<https://data.cairnepal.org/heritage/resource/event/adc2f4ee-e99a-11e9-b125-0242ac130002_1> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Establishment of a library"@en ;
    dcterms:description "Around VS 2040-2045 local youths established a library in the upper floor of the Phalcā. However, the library has been closed for many years as it was seldom used."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/adc2f4ee-e99a-11e9-b125-0242ac130002> ;
