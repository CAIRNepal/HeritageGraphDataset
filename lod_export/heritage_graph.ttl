        hg:Production ;
    rdfs:label "Construction of temple"@en ;
    dcterms:description "Rudramatī, the daughter of King Śrīnivāsa Malla and elder sister of Yoganarendra Malla, built a three-storied temple to the south of Narasiṃha Temple."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/256339d6-e9d3-11e9-8bc4-0242ac130002> ;
