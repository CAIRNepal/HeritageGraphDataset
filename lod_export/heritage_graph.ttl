<https://data.cairnepal.org/heritage/resource/event/34d3a0bc-bf6d-489e-b2a4-9bf09d771740_3> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Endowment of lands"@en ;
    dcterms:description "King Gīrvāṇayuddha granted land with an annual produce of 420murīs to set up a trust to ensure the smooth conduct of worship at Manamāneśvarī."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/34d3a0bc-bf6d-489e-b2a4-9bf09d771740> ;
    rdfs:comment "King Gīrvāṇayuddha granted land with an annual produce of 420murīs to set up a trust to ensure the smooth conduct of worship at Manamāneśvarī."@en ;
