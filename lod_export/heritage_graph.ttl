        hg:HistoricalEvent ;
    rdfs:label "Excavation of the Hiti"@en ;
    dcterms:description "Local youths unearthed the Hiti by excavating the site where their seniors recalled seeing the water spout (see the description above for more information)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/b6d957b1-ade4-4490-998b-efc52b8cfddf> ;
