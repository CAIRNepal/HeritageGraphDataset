<https://data.cairnepal.org/heritage/resource/event/a625bbb3-6095-4c52-a6c6-48393def07a1_0> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Restoration of the temple"@en ;
    dcterms:description "The temple remained unharmed by the 2015 CE earthquakes. Recognizing its need for repairs, the Department of Archaeology initiated the restoration process in 2022 CE (VS 2078). As of April 2023 CE, the temple is currently undergoing reconstruction."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/a625bbb3-6095-4c52-a6c6-48393def07a1> ;
