<https://data.cairnepal.org/heritage/resource/event/0c4477f9-1bd4-4952-85b5-e7f78739c76a_11> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Endowment of lands"@en ;
    dcterms:description "पनौती, दरिनचोक बस्ने सुबेदार रघुबिर बस्न्यात क्षेत्रीले विभिन्न ठाउँमा खेत गुठी राखिदिएका थिए । उक्त खेतको आयस्ताले इन्द्रेश्वर मन्दिरमा प्रत्येक महिनाको शुक्ल पक्षको चतुर्दशी तिथिमा रुद्री गर्नुपर्ने, त्रिवेणी घाटपारि रहेको ब्रह्मायणी मन्दिरमा प्रत्येक महिनाको शुक्ल र कृष्ण पक्षको अष्टमीको दिनमा रुद्री गर्नुपर्ने व्यवस्था गरिएको थियो । उनले त्रिवेणीघाटमा रहेको सतःमा सरसफाइ गर्न र बिग्रेमा मर्मत गर्न पनि व्यवस्था गरिदिएका थिए ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/0c4477f9-1bd4-4952-85b5-e7f78739c76a> ;
    rdfs:comment "पनौती, दरिनचोक बस्ने सुबेदार रघुबिर बस्न्यात क्षेत्रीले विभिन्न ठाउँमा खेत गुठी राखिदिएका थिए । उक्त खेतको आयस्ताले इन्द्रेश्वर मन्दिरमा प्रत्येक महिनाको शुक्ल पक्षको चतुर्दशी तिथिमा रुद्री गर्नुपर्ने, त्रिवेणी घाटपारि रहेको ब्रह्मायणी मन्दिरमा प्रत्येक महिनाको शुक्ल र कृष्ण पक्षको अष्टमीको दिनमा रुद्री गर्नुपर्ने व्यवस्था गरिएको थियो । उनले त्रिवेणीघाटमा रहेको सतःमा सरसफाइ गर्न र बिग्रेमा मर्मत गर्न पनि व्यवस्था गरिदिएका थिए ।"@en ;
