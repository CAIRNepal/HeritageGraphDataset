<https://data.cairnepal.org/heritage/resource/event/c2add511-115d-4d83-bcef-db8ed170a594_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "पाकशालाभित्र विसं १९८२ (सन् १९२५) मा राखिएको वृहत ताम्रपत्र अभिलेख छ । उक्त अभिलेखमा विसं १९४३ वैशाख शुदी तृतीयादेखि शासकबाट गुठी प्रणालीको व्यवस्था भएको कुरा उल्लेख छ । यसै उल्लेखनलाई आधार मानी हाल प्रशासनले पाकशालाको शुभारम्भ मिति मान्ने गरेको छ । अभिलेखमा पाकशालासंगै मन्दिर बने-नबनेको कुरा स्पष्ट खुल्दैन । तर पाकशाला संगसंगै वीरनारायणका नामले मन्दिर पनि उठाइएको अनुमान सहजै गर्न सकिन्छ । विसं १९४५ (सन् १८८८) को गुठी सम्बन्धि लिखित सामग्रीमा पाकशालासंगै यस मन्दिरको पनि प्रसंग परेकाले दुबै एकैसाथ निर्माण भएको कुरालाई थप बल मिल्दछ (K_0037_0019F) ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/c2add511-115d-4d83-bcef-db8ed170a594> ;
    rdfs:comment "पाकशालाभित्र विसं १९८२ (सन् १९२५) मा राखिएको वृहत ताम्रपत्र अभिलेख छ । उक्त अभिलेखमा विसं १९४३ वैशाख शुदी तृतीयादेखि शासकबाट गुठी प्रणालीको व्यवस्था भएको कुरा उल्लेख छ । यसै उल्लेखनलाई आधार मानी हाल प्रशासनले पाकशालाको शुभारम्भ मिति मान्ने गरेको छ । अभिलेखमा पाकशालासंगै मन्दिर बने-नबनेको कुरा स्पष्ट खुल्दैन । तर पाकशाला संगसंगै वीरनारायणका नामले मन्दिर पनि उठाइएको अनुमान सहजै गर्न सकिन्छ । विसं १९४५ (सन् १८८८) को गुठी सम्बन्धि लिखित सामग्रीमा पाकशालासंगै यस मन्दिरको पनि प्रसंग परेकाले दुबै एकैसाथ निर्माण भएको कुरालाई थप बल मिल्दछ (K_0037_0019F) ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
