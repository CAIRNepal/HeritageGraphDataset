<https://data.cairnepal.org/heritage/resource/event/4c31625e-ea78-11e9-8bc4-0242ac130002_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the palace building"@en ;
    dcterms:description "The Government of Nepal renovated the palace during the reign of King Mahendra and established a police post with a small jail in the building. In 1993, the police was moved to the former municipal building on the south side of the square. Sundarī Coka was closed to the public till 2007."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/4c31625e-ea78-11e9-8bc4-0242ac130002> ;
