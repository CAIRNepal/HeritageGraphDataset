<https://data.cairnepal.org/heritage/resource/event/5f3fcfe9-cdca-4c7c-9504-58cc4e019cd0_0> a crm:E5_Event,
        hg:Consecration ;
    rdfs:label "Construction of Dharmamukteśvara"@en ;
    dcterms:description "Rādhākumārīdevī, Thira Śamśera Thāpā, Nara Śamśera Thāpā, Gaṃbhīra Śamśera Thāpā, and Raudra Śamśera Thāpā established the Śiva temple by consecrating Dharmamukteśvara Mahādeva in the sanctum in the name of their father Dharma Śamśera Thāpā Kṣetrī. They also established three additionalśivaliṅgas in the sanctum, namely, Śivamukteśvara in their mother Śivakumārīdevī's name, Śubhamukteśvara in Śubhakumārīdevī's name who probably was their father’s first wife (jeṭhīmumā), and Naramukteśvara in their grandmother Naranandakumārīdevī's name. The siblings also donated land for daily and periodic worships at the temple."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5f3fcfe9-cdca-4c7c-9504-58cc4e019cd0> ;
    rdfs:comment "Rādhākumārīdevī, Thira Śamśera Thāpā, Nara Śamśera Thāpā, Gaṃbhīra Śamśera Thāpā, and Raudra Śamśera Thāpā established the Śiva temple by consecrating Dharmamukteśvara Mahādeva in the sanctum in the name of their father Dharma Śamśera Thāpā Kṣetrī. They also established three additionalśivaliṅgas in the sanctum, namely, Śivamukteśvara in their mother Śivakumārīdevī's name, Śubhamukteśvara in Śubhakumārīdevī's name who probably was their father’s first wife (jeṭhīmumā), and Naramukteśvara in their grandmother Naranandakumārīdevī's name. The siblings also donated land for daily and periodic worships at the temple."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 0 ;
