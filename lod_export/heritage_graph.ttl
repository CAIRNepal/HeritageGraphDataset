        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the monument"@en ;
    dcterms:description "Due to the deteriorating condition of the temple, community members gathered a total of NRs. 3,666 and offered their voluntary labor to initiate the temple's renovation. Their efforts encompassed not only the restoration of the temple but also the construction of a brick plinth for its foundation."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/fb49ddb6-2c68-4965-b235-046da5e9f4fa> ;
