        hg:Production ;
    rdfs:label "Initial construction"@en ;
    dcterms:description "विसं १९६४ बाट जलविद्युत आयोजनाको निर्माण कार्य थालिएको आयोजना समापन भई विसं १९६८ (सन् १९११) जेष्ठ ९ गते सोमवारका दिन तत्कालीन राजाको उपस्थितिमा टुँडिखेलमा बत्ती बाली उद्‌घाटन गरियो । यसै आयोजनाको मुख्य अङ्गका रूपमा बनेका संरचनामध्ये यो पोखरी पनि थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/b184c315-9891-46d1-8d9d-425a7f6fdf53> ;
