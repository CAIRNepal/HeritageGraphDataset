<https://data.cairnepal.org/heritage/resource/event/1176053e-eb54-11e9-8bc4-0242ac130002_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Painting work around donors' statue"@en ;
    dcterms:description "On the occasion of Kājīlāla Avāle'sjaṃkva(thejaṃkvacelebration takes place when a man is 77 years, 7 months and 7 days old), he donated paintings of five Buddhas and of other auspicious signs such as parrots, the eyes of the Buddha, andkalaśasto be placed around the donor statues."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/1176053e-eb54-11e9-8bc4-0242ac130002> ;
