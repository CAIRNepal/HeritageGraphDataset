<https://data.cairnepal.org/heritage/resource/event/8f5e6a23-ea42-4a90-b496-cca35276d255_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the temple"@en ;
    dcterms:description "Indrasiṃha Duvāra constructed the Bhavānīśaṅkara temple in honor of his son, Purṇṇarāma."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/8f5e6a23-ea42-4a90-b496-cca35276d255> ;
    rdfs:comment "Indrasiṃha Duvāra constructed the Bhavānīśaṅkara temple in honor of his son, Purṇṇarāma."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
