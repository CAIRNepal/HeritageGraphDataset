<https://data.cairnepal.org/heritage/resource/event/54612871-717c-41e1-9a91-cf77d1267bad_6> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Unknown event"@en ;
    dcterms:description "This inscription bears a date NS 836 carved at the end of the text. In order to donate thepīṭhawith the intention of seeking liberation for a family member, certain arrangements were made within thepīṭhaprecinct. Written entirely in Sanskrit, the full meaning of this inscription has not been fully deciphered."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/54612871-717c-41e1-9a91-cf77d1267bad> ;
