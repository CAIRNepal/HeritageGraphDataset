<https://data.cairnepal.org/heritage/resource/event/ab1acf4e-11d5-4ef6-b81b-010e94840e54_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation"@en ;
    dcterms:description "Lack of care and renovations for a long period had developed the Hiti into bushes. In 2019 CE, the Kirtipur Municipality reconstructed the monument. At the same time, the statues of Viṣṇu, Nāga and Bhagīratha were added in the hiti premises."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/ab1acf4e-11d5-4ef6-b81b-010e94840e54> ;
