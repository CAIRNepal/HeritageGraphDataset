<https://data.cairnepal.org/heritage/resource/event/7947965c-44e3-4fc0-b14e-7d781f54dca2_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the Phalcā"@en ;
    dcterms:description "An inscription on the phalcā, dating to 1758 CE (NS 878), documents the construction of a brick wall in the Dharmaśālā (phalcā) by Pūrṇatāja Vajrācāryā and his family members. Although this inscription does not offer specific details about the initial construction of the phalcā, it confirms that the structure existed during the Malla period."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/7947965c-44e3-4fc0-b14e-7d781f54dca2> ;
    rdfs:comment "An inscription on the phalcā, dating to 1758 CE (NS 878), documents the construction of a brick wall in the Dharmaśālā (phalcā) by Pūrṇatāja Vajrācāryā and his family members. Although this inscription does not offer specific details about the initial construction of the phalcā, it confirms that the structure existed during the Malla period."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 0 ;
    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/7947965c-44e3-4fc0-b14e-7d781f54dca2> .

