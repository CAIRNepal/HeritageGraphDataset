    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 0 ;
    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/77b88f79-3bc0-4373-8673-e60310fa5c97> .

<https://data.cairnepal.org/heritage/resource/event/77b88f79-3bc0-4373-8673-e60310fa5c97_1> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Construction of a sataḥ and endowment of land."@en ;
    dcterms:description "The inscription dated 1558 CE (NS 679) records the construction of asataḥat the Sālkhā Ṭola and endowment of many plots of land, providing income to feed the Jaṅgama ascetics who are said to have come from abroad.This inscription from the Malla period kept next to the eastern plinth is not related to Mandaḥ Phalcā."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/77b88f79-3bc0-4373-8673-e60310fa5c97> ;
    rdfs:comment "The inscription dated 1558 CE (NS 679) records the construction of asataḥat the Sālkhā Ṭola and endowment of many plots of land, providing income to feed the Jaṅgama ascetics who are said to have come from abroad.This inscription from the Malla period kept next to the eastern plinth is not related to Mandaḥ Phalcā."@en ;
