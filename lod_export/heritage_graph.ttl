        hg:HistoricalEvent ;
    rdfs:label "Lightning at the temple complex"@en ;
    dcterms:description "The Gũ Bāhāḥ premises were struck by lightning. Fortunately, the priest of the temple was unharmed as he lay prostrate on the ground. However, when the Temple's door was opened the following day, soot marks were observed on the statue of temple andits left earring (kuṇḍala)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f5a48d0e-2f70-4721-abb2-614f7311dec9> ;
