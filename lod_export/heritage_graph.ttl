    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 1 ;
    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/af614ba6-19ef-4239-aeea-fb3a9106e659> .

<https://data.cairnepal.org/heritage/resource/event/af614ba6-19ef-4239-aeea-fb3a9106e659_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "First reconstruction of the phalcā"@en ;
    dcterms:description "A concrete square building of two floors was erected in place of the Mandaḥ Phalcā, with a portion of the ground floor left open while the upper floor utilized for the operation of a public library named “Pūcva Pustakālaya.” Meanwhile, thejaḥdhuṃmentioned in the inscription no longer exists, as it was never restored after this reconstruction of thephalcā. The stone water container of thejaḥdhuṃwas relocated to the nearby Lāchi Ṭola, while the stone blocks in excellent condition were repurposed for renovating the nearby Pulcoka Lohãhiti (LAL0570)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/af614ba6-19ef-4239-aeea-fb3a9106e659> ;
    rdfs:comment "A concrete square building of two floors was erected in place of the Mandaḥ Phalcā, with a portion of the ground floor left open while the upper floor utilized for the operation of a public library named “Pūcva Pustakālaya.” Meanwhile, thejaḥdhuṃmentioned in the inscription no longer exists, as it was never restored after this reconstruction of thephalcā. The stone water container of thejaḥdhuṃwas relocated to the nearby Lāchi Ṭola, while the stone blocks in excellent condition were repurposed for renovating the nearby Pulcoka Lohãhiti (LAL0570)."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 2 ;
    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/af614ba6-19ef-4239-aeea-fb3a9106e659> .

<https://data.cairnepal.org/heritage/resource/event/af614ba6-19ef-4239-aeea-fb3a9106e659_3> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Second reconstruction of the phalcā"@en ;
    dcterms:description "The concrete structure that replaced the traditional Mandaḥ Phalcā sustained damage in the 2015 earthquakes. It was once again dismantled and rebuilt as a concrete structure in 2020 CE (VS 2077) by the donor family with financial assistance from an NGO named Prārambha. The donor family provided a finial that now crowns thephalcā, while the Lalitpur Metropolis supplied veneer bricks. The library, Pūcva Pustakālaya, continues to operate from thephalcā’s upper floor onwards. Notably, an inscription installed after the recent reconstruction erroneously mentions that thephalcāwas originally built in 1709 CE (NS 829), the year the donor family set up a trust in the name of thephalcābuilt five years previously."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/af614ba6-19ef-4239-aeea-fb3a9106e659> ;
    rdfs:comment "The concrete structure that replaced the traditional Mandaḥ Phalcā sustained damage in the 2015 earthquakes. It was once again dismantled and rebuilt as a concrete structure in 2020 CE (VS 2077) by the donor family with financial assistance from an NGO named Prārambha. The donor family provided a finial that now crowns thephalcā, while the Lalitpur Metropolis supplied veneer bricks. The library, Pūcva Pustakālaya, continues to operate from thephalcā’s upper floor onwards. Notably, an inscription installed after the recent reconstruction erroneously mentions that thephalcāwas originally built in 1709 CE (NS 829), the year the donor family set up a trust in the name of thephalcābuilt five years previously."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
