<https://data.cairnepal.org/heritage/resource/event/affdfc0b-621a-491a-84dc-41757d1d0909_2> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Rebuilding of the southern house of the Āgaṃchẽ"@en ;
    dcterms:description "The southern building attached to the tiered structure collapsed in the 2015 earthquakes, leaving the main building of theāgaṃchẽpartially damaged. The collapsed portion was rebuilt in 2019 CE (VS 2076) while the main building was also renovated. Wooden supports were later added to the main building."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/affdfc0b-621a-491a-84dc-41757d1d0909> ;
