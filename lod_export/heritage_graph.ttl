    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/2f6ff45c-890f-4b5f-9c44-864b0b71ca7d> .

<https://data.cairnepal.org/heritage/resource/event/2f6ff45c-890f-4b5f-9c44-864b0b71ca7d_2> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Addition of a bell"@en ;
    dcterms:description "Following the completion of the temple in 2024 CE (VS 2082), a local couple, Jagat Bahādur Śreṣṭha and Sānumāyā Śreṣṭha, along with their family, installed a bell on the plinth at the temple facade."@en ;
