    rdfs:label "Rebuilding of the temple"@en ;
    dcterms:description "The temple was rebuilt by the Vaiṣṇava family following the 1934 earthquake."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5bfb6d40-eb4c-11e9-b125-0242ac130002> ;
