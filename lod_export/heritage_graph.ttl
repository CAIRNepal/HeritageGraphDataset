<https://data.cairnepal.org/heritage/resource/event/d13507a3-aaee-4f4a-9f55-8546a8a801d8_3> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Rebuilt and inauguration"@en ;
    dcterms:description "The National Reconstruction Authority completed the reconstruction of both Rānīpokharī and the Bālagopāleśvara temple, strictly following Malla-period style, techniques, and materials. The rebuilt Rānīpokharī and Bālagopāleśvara temple were then inaugurated by President Vidyā Devi Bhandari."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d13507a3-aaee-4f4a-9f55-8546a8a801d8> ;
