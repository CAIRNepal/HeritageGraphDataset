<https://data.cairnepal.org/heritage/resource/event/995c1376-9e84-42a2-8f05-38b8d8a32a23_6> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Installation of copperplate inscription"@en ;
    dcterms:description "Commemorating the laying of floor tiles in thebāhāḥpremises and renovation of the main shrine, Ratnamāna installed a copperplate inscription north of the main deity."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/995c1376-9e84-42a2-8f05-38b8d8a32a23> ;
