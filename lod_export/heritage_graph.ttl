<https://data.cairnepal.org/heritage/resource/event/7bdbbf54-d9cd-4572-9240-8b8c70734274_3> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Establishment of the statue of Amoghasiddhi"@en ;
    dcterms:description "मन्दिरअगाडि दबूमा रहेको धर्मधातु मण्डलको उत्तरपट्टि अमोघसिद्धिको मूर्ति स्थापना गरिएको थियो । उक्त मूर्ति स्थापना गर्ने दाताको नाम अभिलेखमा कुँदिएको छैन ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/7bdbbf54-d9cd-4572-9240-8b8c70734274> ;
