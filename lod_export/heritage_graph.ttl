<https://data.cairnepal.org/heritage/resource/event/0f14007d-53ac-4148-8478-6a2f8b447e82_5> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Reconstruction"@en ;
    dcterms:description "Following damage sustained in the 2015 earthquakes, the temple was reconstructed in 2023 CE (VS 2079) with financial support from the Department of Archaeology and Chandragiri Municipality, alongside the active participation of the Gaṇeśa Bhagavatī Kālikā Rājaguthi, a religious trust associated with the temple."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/0f14007d-53ac-4148-8478-6a2f8b447e82> ;
