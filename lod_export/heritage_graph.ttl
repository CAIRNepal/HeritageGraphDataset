<https://data.cairnepal.org/heritage/resource/event/62c22c28-9633-4f6d-a6e2-f942cf73af1c_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the temple"@en ;
    dcterms:description "The temple underwent renovation by the Pashupati Area Development Trust in 2002 CE (VS 2059). A marble inscription installed after the renovation identifies the temple as the Rudreśvara Śivālaya."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/62c22c28-9633-4f6d-a6e2-f942cf73af1c> ;
    rdfs:comment "The temple underwent renovation by the Pashupati Area Development Trust in 2002 CE (VS 2059). A marble inscription installed after the renovation identifies the temple as the Rudreśvara Śivālaya."@en ;
