    rdfs:label "Inscription of the pillar"@en ;
    dcterms:description "The pillar contains at least 15 lines of text inscribed in a Nāgarī script. The text is eroded in some places.No date could be identified."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/08a88f31-b68f-4b72-9e2c-19de80a9c766> ;
