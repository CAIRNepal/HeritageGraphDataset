        hg:Production ;
    rdfs:label "Organizing Samyaka Mahādāna"@en ;
    dcterms:description "During the reign of King Narendra Malla, Tuyū Āḥju, who founded thebāhāḥ, hosted the Samyak Mahādāna ceremony and established a statue of Dīpaṅkara in memory of his father Jīvāju."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/a9dcf214-13cc-4b71-8b0c-488ff996713b> ;
