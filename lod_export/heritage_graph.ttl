        hg:Production ;
    rdfs:label "Kṣamāpūjā for the construction of shrine"@en ;
    dcterms:description "The Bālakumārī Pīṭha, which was previously open along the roadside, was made secure by adding a roof and enclosing it from all sides. Akṣamāpūjā(penance) was performed before starting the work."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/5486b15f-7b52-40db-8996-3110eebd8b37> ;
