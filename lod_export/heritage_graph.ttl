<https://data.cairnepal.org/heritage/resource/event/d52dcb5c-6f3b-4b23-86d0-de4e40dddda0_3> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Destruction by earthquakes"@en ;
    dcterms:description "Both the temple and thecaugharāsataḥaround it were destroyed in the 2015 CE earthquakes. The structures were already in poor condition due to the lack of proper care and timely renovations."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d52dcb5c-6f3b-4b23-86d0-de4e40dddda0> ;
