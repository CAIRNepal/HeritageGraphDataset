<https://data.cairnepal.org/heritage/resource/event/911c76c5-2991-472c-9412-af01e78ef9ac_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the Nāsaḥdyaḥ Temple"@en ;
    dcterms:description "As the Nāsaḥdyaḥ temple became dilapidated over time, the locals contributed donations to rebuild it in 1853 CE (NS 973).नासःद्यःको मन्दिर जीर्ण भएकोले टोलबासीसँग चन्दा उठाएर जीर्णोद्धार गरिएको थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/911c76c5-2991-472c-9412-af01e78ef9ac> ;
    rdfs:comment "As the Nāsaḥdyaḥ temple became dilapidated over time, the locals contributed donations to rebuild it in 1853 CE (NS 973).नासःद्यःको मन्दिर जीर्ण भएकोले टोलबासीसँग चन्दा उठाएर जीर्णोद्धार गरिएको थियो ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
