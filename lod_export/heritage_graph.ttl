    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/df484d8d-869e-4447-a7a9-a38a889ed310> .

<https://data.cairnepal.org/heritage/resource/event/df484d8d-869e-4447-a7a9-a38a889ed310_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation"@en ;
    dcterms:description "The inscription on the outer west wall of the temple names Vaṃśamuni Ācārya as the founder and records a renovation carried out by his descendant Hari Ācārya."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/df484d8d-869e-4447-a7a9-a38a889ed310> ;
    rdfs:comment "The inscription on the outer west wall of the temple names Vaṃśamuni Ācārya as the founder and records a renovation carried out by his descendant Hari Ācārya."@en ;
