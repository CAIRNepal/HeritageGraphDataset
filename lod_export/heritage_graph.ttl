<https://data.cairnepal.org/heritage/resource/event/937ecfa8-3a1d-45c5-b900-96a71cfd3a23_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the Vatsalā Temple"@en ;
    dcterms:description "King Jitāmītra Malla, after composing the dance-drama version of theAdhyātma Rāmāyaṇa, built the Vatsalā temple for the performance of thesiddhipūjā. The inscription installed during the temple’s construction refers to the deity as Karma-Vatsalā.राजा जितामित्र मल्लले अध्यात्म रामायणको नृत्य रचेपछि सिद्धिपूजा गर्नको लागि वत्सला मन्दिर निर्माण गरेका थिए । मन्दिर निर्माण गर्दा राखिएको अभिलेखमा उक्त वत्सलालाई 'कर्म-वत्सला' भनिएको छ ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/937ecfa8-3a1d-45c5-b900-96a71cfd3a23> ;
    rdfs:comment "King Jitāmītra Malla, after composing the dance-drama version of theAdhyātma Rāmāyaṇa, built the Vatsalā temple for the performance of thesiddhipūjā. The inscription installed during the temple’s construction refers to the deity as Karma-Vatsalā.राजा जितामित्र मल्लले अध्यात्म रामायणको नृत्य रचेपछि सिद्धिपूजा गर्नको लागि वत्सला मन्दिर निर्माण गरेका थिए । मन्दिर निर्माण गर्दा राखिएको अभिलेखमा उक्त वत्सलालाई 'कर्म-वत्सला' भनिएको छ ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 0 ;
