        hg:DestructionEvent ;
    rdfs:label "Reconstruction"@en ;
    dcterms:description "Following the 2015 earthquakes, the Dharmaśālā was reconstructed by the Bāgamatī Civilization Integrated Development Committee under the Ministry of Urban Development, with a loan from the Asian Development Bank. The reconstruction was completed on October 23, 2022 CE (VS 2079)."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/51fcc336-5270-47c3-8ab7-56f82bc96859> ;
