    rdfs:label "Land endowment"@en ;
    dcterms:description "A land grant of 150ropanīs was made in the name of Hanumantasiṃha Amātya for the expansion of settlements in Kupondole and the maintenance of the bridge."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/91ae947b-5f53-49ec-82f2-a6e9445ead42> ;
