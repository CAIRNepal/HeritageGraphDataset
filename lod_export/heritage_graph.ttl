<https://data.cairnepal.org/heritage/resource/event/911c76c5-2991-472c-9412-af01e78ef9ac_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the Nāsaḥdyaḥ Temple"@en ;
    dcterms:description "During the reign of King Raṇajita Malla, Dhanabilasiṃ (Dhanavīrasiṃ), Bhāgivantasiṃ, and other Dāphā group members built a proper temple for Nāsaḥdyaḥ where Hāku Bande served as the priest.राजा रणजित मल्लको राज्यकालमा धनबिलसिं (धनवीरसिं), भागिवन्तसिं लगायतका दाफा खलकका सदस्यहरूले मिलेर नासःद्यःको लागि मन्दिर निर्माण गरेका थिए । उक्त काममा हाकु बन्देले पुरोहितको काम गरेका थिए ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/911c76c5-2991-472c-9412-af01e78ef9ac> ;
    rdfs:comment "During the reign of King Raṇajita Malla, Dhanabilasiṃ (Dhanavīrasiṃ), Bhāgivantasiṃ, and other Dāphā group members built a proper temple for Nāsaḥdyaḥ where Hāku Bande served as the priest.राजा रणजित मल्लको राज्यकालमा धनबिलसिं (धनवीरसिं), भागिवन्तसिं लगायतका दाफा खलकका सदस्यहरूले मिलेर नासःद्यःको लागि मन्दिर निर्माण गरेका थिए । उक्त काममा हाकु बन्देले पुरोहितको काम गरेका थिए ।"@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
