<https://data.cairnepal.org/heritage/resource/event/65ef3af4-9d6a-11ea-82af-0242ac130005_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Paving a platform with brick"@en ;
    dcterms:description "A platform paved with terracotta bricks (teliyā) was constructed to serve as a venue for meetings of the five village elders (pañcasamūha). It can be assumed that such meetings took place in front of thephalcāduring the late Malla period, where elders convened to resolve local disputes."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/65ef3af4-9d6a-11ea-82af-0242ac130005> ;
