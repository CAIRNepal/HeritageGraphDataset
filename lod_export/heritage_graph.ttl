<https://data.cairnepal.org/heritage/resource/event/c4f5a233-92eb-49e5-9c09-8bb123453f98_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Installation of a waterspout"@en ;
    dcterms:description "The waterspout, located in front of thesataḥand right on the river bank, was constructed by the Vāgamatī Kṣetra Ḍhala Nirmāṇa Sudhāra Āyojanā Kāryanvayana tathā Anugamana Samiti, a government body dedicated to drainage management in the Vāgamatī area."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/c4f5a233-92eb-49e5-9c09-8bb123453f98> ;
