<https://data.cairnepal.org/heritage/resource/event/7286700f-4313-42ba-be54-d79933e086a4_1> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Initial construction of the Hiti and the endowment of land for its maintenance"@en ;
    dcterms:description "Maṅgaḥ Hiti was constructed by Bhāravi, the son of Mānadeva's daughter, to support the residents of Yūpagrāma. He endowed land from the south-west of Yūpagrāma for the hiti's maintenance."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/7286700f-4313-42ba-be54-d79933e086a4> ;
