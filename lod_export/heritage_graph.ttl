<https://data.cairnepal.org/heritage/resource/event/4866412c-db26-4c5c-9a7b-2fba0dff932d_0> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Collapsed during the 1833 CE earthquakes"@en ;
    dcterms:description "The Temple completely collapsed during the 1833 CE earthquakes, and was never restored. Its large three-layered plinths suggest that there was a big (at least two-storey pagoda-styled) temple here in the past."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/4866412c-db26-4c5c-9a7b-2fba0dff932d> ;
    rdfs:comment "The Temple completely collapsed during the 1833 CE earthquakes, and was never restored. Its large three-layered plinths suggest that there was a big (at least two-storey pagoda-styled) temple here in the past."@en ;
