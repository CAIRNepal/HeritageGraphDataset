<https://data.cairnepal.org/heritage/resource/event/89c37d61-e8db-4b2d-9550-d8879f02d514_4> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Installation of a statue"@en ;
    dcterms:description "Mahant Sundara Puri's disciple, Vada (or possibly Buddha?) Purī, built a stone idol of his preceptor (guru) in the premises of the maṭha.महन्त सुन्दर पुरीका शिष्य वद (बुद्ध ?) पुरीले आफ्ना गुरुको शिलामूर्ति निर्माण गरी मठ प्राङ्गणमा स्थापना गरे ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/89c37d61-e8db-4b2d-9550-d8879f02d514> ;
