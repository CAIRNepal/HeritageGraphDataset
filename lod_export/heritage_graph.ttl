    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/2af3fc6d-7bc2-4922-b562-7232446814f0> .

<https://data.cairnepal.org/heritage/resource/event/2af3fc6d-7bc2-4922-b562-7232446814f0_3> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Offering of musical instrument"@en ;
    dcterms:description "Mānakṛṣṇa Bhāro and his family from the Jalacapāḥkva Ṭola offered a set of five musical instruments to the temple. The inscription mandates the performance of these instruments during the morning and evening rituals daily. The Badyakāra andjogicommunities were required to repair the instruments in case they were damaged. Thejogis who performed these instruments were allowed to till fiveropanīs of land."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2af3fc6d-7bc2-4922-b562-7232446814f0> ;
    rdfs:comment "Mānakṛṣṇa Bhāro and his family from the Jalacapāḥkva Ṭola offered a set of five musical instruments to the temple. The inscription mandates the performance of these instruments during the morning and evening rituals daily. The Badyakāra andjogicommunities were required to repair the instruments in case they were damaged. Thejogis who performed these instruments were allowed to till fiveropanīs of land."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
    hg:eventIndex 3 ;
    hg:extractionMethod "source_table" ;
    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/2af3fc6d-7bc2-4922-b562-7232446814f0> .

<https://data.cairnepal.org/heritage/resource/event/2af3fc6d-7bc2-4922-b562-7232446814f0_4> a crm:E5_Event,
        hg:TransferOfCustody ;
    rdfs:label "Land endowment for Śrīdharanārāyaṇa temple"@en ;
    dcterms:description "The Śrīdharanārāyaṇa temple in Thaiba was renovated and nineropanīs of land were donated to set up a religious trust to arrange an income for the temple. Two priests, Mādhavarāja Upādhyāya and Candreśvarānanda Upādhyāya, were given the responsibility of performing daily and periodic worships at the temple and offer the gifts (prasāda) from the deity to the donor family and local administration office. Out of the annual income, twomoharas were to be saved to fund the timely renovations of the temple. The trust members were required to worship Buṅgadyaḥ on the first day of the solar month, and worship Gaṇeśa from this temple and Bhūteśvara of Thaiba on the 14th of the dark fortnight of Caitra."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/2af3fc6d-7bc2-4922-b562-7232446814f0> ;
    rdfs:comment "The Śrīdharanārāyaṇa temple in Thaiba was renovated and nineropanīs of land were donated to set up a religious trust to arrange an income for the temple. Two priests, Mādhavarāja Upādhyāya and Candreśvarānanda Upādhyāya, were given the responsibility of performing daily and periodic worships at the temple and offer the gifts (prasāda) from the deity to the donor family and local administration office. Out of the annual income, twomoharas were to be saved to fund the timely renovations of the temple. The trust members were required to worship Buṅgadyaḥ on the first day of the solar month, and worship Gaṇeśa from this temple and Bhūteśvara of Thaiba on the 14th of the dark fortnight of Caitra."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
    prov:wasGeneratedBy <https://data.cairnepal.org/heritage/resource/activity/heritagegraph_kg_construction> ;
