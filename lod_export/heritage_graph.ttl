        hg:Production ;
    rdfs:label "Renovation of the bāhāḥ dyaḥchẽ"@en ;
    dcterms:description "फ्रेण्ड्स अफ जर्मनीको आर्थिक सहयोगमा बाहाः द्यःछेँ जीर्णोद्धार गरिएको थियो । पुरातत्त्व विभागमा कार्यरत गुह्यहर्ष वज्राचार्यको प्रयासमा उक्त आर्थिक सहयोग प्राप्त भएको थियो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/e0c3eb25-fbc0-421c-b0ec-df3d88d3a7ef> ;
