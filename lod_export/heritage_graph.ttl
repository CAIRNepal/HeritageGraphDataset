<https://data.cairnepal.org/heritage/resource/event/df484d8d-869e-4447-a7a9-a38a889ed310_2> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Renovation"@en ;
    dcterms:description "The inscription recording this event states that the temple, renovated in 1819 CE (VS 1876), was damaged in the 1934 CE (VS 1990) earthquake and subsequently restored by Nārayaṇamaṇi Ācārya, the great-grandson of Harinārāyaṇa Ācārya, who had overseen the earlier renovation."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/df484d8d-869e-4447-a7a9-a38a889ed310> ;
