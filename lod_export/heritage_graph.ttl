    hg:isEventOf <https://data.cairnepal.org/heritage/resource/monument/f2fd559b-9b9c-4c38-a353-9ee22dad0272> .

<https://data.cairnepal.org/heritage/resource/event/f2fd559b-9b9c-4c38-a353-9ee22dad0272_1> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Releasing funds to repair the palace roof"@en ;
    dcterms:description "During repairs to the palace, King Pratāpa Siṃha Śāha sent nine rupees to thedhāmīto purchase thatch for the roof.राजा प्रतापसिंह शाहले दरबारको मर्मत गर्ने क्रममा छानाको लागि खर किन्न नौ रुपैयाँ धामीलाई पठाएका थिए ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f2fd559b-9b9c-4c38-a353-9ee22dad0272> ;
    rdfs:comment "During repairs to the palace, King Pratāpa Siṃha Śāha sent nine rupees to thedhāmīto purchase thatch for the roof.राजा प्रतापसिंह शाहले दरबारको मर्मत गर्ने क्रममा छानाको लागि खर किन्न नौ रुपैयाँ धामीलाई पठाएका थिए ।"@en ;
