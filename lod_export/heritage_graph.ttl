        hg:Production ;
    rdfs:label "Pasting of gilt sheet"@en ;
    dcterms:description "During the reign of King Surendra, the temple’s previous tile roof was replaced with gilt copper sheets. Similar gilt eave boards, inscribed with embossed letters, were also installed on all sides of the upper roof."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/b071cb98-09af-42ce-8334-6ea037aacb5e> ;
