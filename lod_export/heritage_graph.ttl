        hg:DestructionEvent ;
    rdfs:label "Earthquake damage"@en ;
    dcterms:description "The building was severely damaged in the 2015 earthquakes. The roof was badly damaged and four corner struts collapsed. Three of them were preserved in the library, while one has been lost."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/69370820-1ef5-11ea-b74e-0242ac130002> ;
