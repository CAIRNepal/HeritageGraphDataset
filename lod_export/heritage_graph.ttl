<https://data.cairnepal.org/heritage/resource/event/26be7902-a8b4-403e-a593-00cde09fc614_0> a crm:E5_Event,
        hg:HistoricalEvent ;
    rdfs:label "Initial establishment of the statue"@en ;
    dcterms:description "A group of donors led by Manoharasiṃha Bhāro established the statue of Buḍābhīmasena. According to the inscription recording this event, the donors hailed from Bhaktapur, Banepa, and Sanga, suggesting that traders from various settlements under the Bhaktapur kingdom settled in Dāpcā for trade purposes. Their collective efforts led to the establishment of the Bhīmasena statue."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/26be7902-a8b4-403e-a593-00cde09fc614> ;
    rdfs:comment "A group of donors led by Manoharasiṃha Bhāro established the statue of Buḍābhīmasena. According to the inscription recording this event, the donors hailed from Bhaktapur, Banepa, and Sanga, suggesting that traders from various settlements under the Bhaktapur kingdom settled in Dāpcā for trade purposes. Their collective efforts led to the establishment of the Bhīmasena statue."@en ;
    prov:wasAttributedTo <https://data.cairnepal.org/heritage/resource/agent/antigravity_agent> ;
