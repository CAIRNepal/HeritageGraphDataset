<https://data.cairnepal.org/heritage/resource/event/f142c371-6fa0-4599-ad3f-8bd47469406e_3> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Damaged in the 2015 earthquakes"@en ;
    dcterms:description "विसं २०७२ (सन् २०१५) को भूकम्पमा देशको थुप्रै मठमन्दिरहरू ध्वस्त भए भने केही मन्दिरहरू जीर्ण भएका थिए । यो मन्दिरले पनि उक्त महाभूकम्पका कार ठूलो क्षति बेहोरनु पर्यो ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/f142c371-6fa0-4599-ad3f-8bd47469406e> ;
