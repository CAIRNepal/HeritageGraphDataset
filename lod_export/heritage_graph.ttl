<https://data.cairnepal.org/heritage/resource/event/3eed6ff1-e60f-4425-b7dc-052f8094f611_8> a crm:E5_Event,
        hg:Consecration ;
    rdfs:label "Installation of the Bhairava mask inside the phalcā"@en ;
    dcterms:description "Consecration rituals were performed on the Bhairava mask for two days when it was enshrined inside the Phalcā."@en ;
