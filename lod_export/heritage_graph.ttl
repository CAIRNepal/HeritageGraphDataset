        hg:HistoricalEvent ;
    rdfs:label "Addition of a bell (2)"@en ;
    dcterms:description "A bell was installed on the northwestern corner of the temple. The name of the donor could not be read due to the placement of metal bars around the bell."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d30593b5-c63b-47d9-90a0-b101b2ebac77> ;
