<https://data.cairnepal.org/heritage/resource/event/03450b1b-4e03-4331-a079-202719840a5c_2> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Renovation of the monument"@en ;
    dcterms:description "Caityarāja and Vikuratna, descendants of the temple builders, later renovated the temple in recognition of their ancestors’ contributions.मन्दिर निर्माताका सन्तति चैत्यराज र विकुरत्नले आफ्ना पूर्खाको कृतिलाई महत्व दिँदै मन्दिरको जीर्णोद्धार गरे ।"@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/03450b1b-4e03-4331-a079-202719840a5c> ;
    rdfs:comment "Caityarāja and Vikuratna, descendants of the temple builders, later renovated the temple in recognition of their ancestors’ contributions.मन्दिर निर्माताका सन्तति चैत्यराज र विकुरत्नले आफ्ना पूर्खाको कृतिलाई महत्व दिँदै मन्दिरको जीर्णोद्धार गरे ।"@en ;
