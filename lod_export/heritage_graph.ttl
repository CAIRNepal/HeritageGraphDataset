<https://data.cairnepal.org/heritage/resource/event/11b82f01-2cae-49fc-9fb2-eb6ce6c896bc_0> a crm:E5_Event,
        hg:DestructionEvent ;
    rdfs:label "Reconstruction"@en ;
    dcterms:description "As the Phalcā was on the verge of collapse, it was dismantled and rebuilt at the initiation of local residents. Using brick and cement, it was rebuilt as a two-bay concrete shed, making the Phalcā lose its traditional look."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/11b82f01-2cae-49fc-9fb2-eb6ce6c896bc> ;
