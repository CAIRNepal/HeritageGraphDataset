<https://data.cairnepal.org/heritage/resource/event/cbbbc576-3b42-11ea-b44d-0242ac130006_6> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Demolition and Reconstruction"@en ;
    dcterms:description "Between 2019 and 2021, Ikhālakhu Phalcā, then built in cement, has been rebuilt using wood and brick, no historic materials have been used. The niches with deities have been removed, in March 2022, the statues made from stone have been placed on wooden shelves."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/cbbbc576-3b42-11ea-b44d-0242ac130006> ;
