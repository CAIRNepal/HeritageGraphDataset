<https://data.cairnepal.org/heritage/resource/event/d9c9b8a3-7e8c-4e73-8382-9e058d98339d_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction"@en ;
    dcterms:description "Commander-in-Chief Raṇa Śamśera's wife built the Ḍambaramukteśvara temple in memory of her late husband. Her identity is unclear, as she is only referred to as \"Śrī Rānī\" (lit. venerated queen) in the inscription."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/d9c9b8a3-7e8c-4e73-8382-9e058d98339d> ;
