<https://data.cairnepal.org/heritage/resource/event/90ae9fac-535a-4b18-9034-d97dda03d621_0> a crm:E12_Production,
        crm:E5_Event,
        hg:Production ;
    rdfs:label "Construction of the śivālaya"@en ;
    dcterms:description "Dhīra Śamśera Rāṇā, the youngest brother of Jaṅga Bahādura, erected Dhīrabhakteśvara as an expression of his reverence to Lord Śiva. Additionally, he donated land parcels along with water and oil mills to generate income for the temple, covering the costs of daily and occasional rituals, as well as compensating the priest, cleaners, and musicians for their contributions to the temple."@en ;
    crm:P12_occurred_in_the_presence_of <https://data.cairnepal.org/heritage/resource/monument/90ae9fac-535a-4b18-9034-d97dda03d621> ;
