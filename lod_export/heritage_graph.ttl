        hg:DestructionEvent ;
    rdfs:label "Renovation of the temple"@en ;
    dcterms:description "Following earthquake damage, the Bhaktapur Municipality undertook a comprehensive renovation of the temple. The public participated extensively in volunteer efforts, and significant financial and material contributions were received, enabling the project's completion by the end of 2020 CE."@en ;
