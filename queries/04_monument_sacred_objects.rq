# Query 4: Sacred Objects, Murtis, and Architectural Elements housed in monuments
PREFIX hgn: <https://w3id.org/heritagegraph-nepal/vocab#>
PREFIX hg: <https://cair-nepal.org/heritagegraph/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?monumentName ?objectID ?objectName ?objectClass ?material ?location WHERE {
    ?monument crm:P46_is_composed_of|hgn:containsObject ?object ;
              rdfs:label ?monumentName .
    
    ?object a ?objectClass ;
            rdfs:label ?objectName ;
            crm:P1_is_identified_by ?identifier .
    ?identifier crm:P2_has_type hgn:DanamObjectNumber ;
                crm:P190_has_symbolic_content ?objectID .
    
    OPTIONAL { ?object hg:material ?material }
    OPTIONAL { ?object hg:locationWithinMonument ?location }

    # Show the non-CRM classes; for an object that has none (a plain human-made object), show crm:E22_Human-Made_Object
    FILTER(!STRSTARTS(STR(?objectClass), STR(crm:))
           || (?objectClass = crm:E22_Human-Made_Object
               && NOT EXISTS { ?object a ?other FILTER(!STRSTARTS(STR(?other), STR(crm:))) }))
}
ORDER BY ?monumentName ?objectID
LIMIT 25
