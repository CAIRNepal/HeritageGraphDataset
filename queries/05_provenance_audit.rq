# Query 5: Full Provenance Audit via W3C PROV-O, Dublin Core, and Antigravity Skill
# Tracing facts to Software Agent (Antigravity), Skill, Organization (CAIR-Nepal), and DANAM URLs
PREFIX hg: <https://w3id.org/cair/heritagegraph/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?monumentName ?eventName ?agentName ?skillName ?organizationName ?danamReportURL ?primarySource WHERE {
    ?monument a hg:ArchitecturalStructure ;
              rdfs:label ?monumentName ;
              prov:wasDerivedFrom ?danamReportURL ;
              hg:hasEvent ?event .
    
    ?event rdfs:label ?eventName ;
           prov:wasAttributedTo ?agent .
    
    ?agent rdfs:label ?agentName ;
           hg:skill ?skillName ;
           prov:actedOnBehalfOf ?org .
    
    ?org rdfs:label ?organizationName .
    
    OPTIONAL { ?event prov:hadPrimarySource ?primarySource }
}
LIMIT 25
